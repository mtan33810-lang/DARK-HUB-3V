 --==================================================
-- POST EGG PICKUP FLOW - FIXED
--==================================================

local VolcanoPostDelay = 10
local EggDropPostDelay = 3

local function RunAfterEggPickup(Egg)

    if PostPickupRunning then
        return
    end

    PostPickupRunning = true

    task.spawn(function()

        local Success, ErrorMessage = pcall(function()

            --==================================================
            -- TWEEN TO MY PLOT
            --==================================================

            local function TweenToMyPlot()

                local Character =
                    Player.Character
                    or Player.CharacterAdded:Wait()

                local Root =
                    Character:WaitForChild("HumanoidRootPart")

                local Plot = FindMyPlot()

                if not Plot then
                    warn("[EGG FLOW] My plot not found")
                    return false
                end

                local PlotCFrame =
                    GetPlotCFrame(Plot)

                if not PlotCFrame then
                    warn("[EGG FLOW] Plot position not found")
                    return false
                end

                local TargetCFrame =
                    PlotCFrame + Vector3.new(0, 5, 0)

                print("[EGG FLOW] Tweening to My Plot")

                local Distance =
                    (Root.Position - TargetCFrame.Position).Magnitude

                local Duration =
                    math.clamp(Distance / 150, 1, 4)

                local StartCFrame =
                    Root.CFrame

                local StartTime =
                    os.clock()

                while true do

                    local Alpha =
                        math.clamp(
                            (os.clock() - StartTime) / Duration,
                            0,
                            1
                        )

                    Root.CFrame =
                        StartCFrame:Lerp(
                            TargetCFrame,
                            Alpha
                        )

                    Root.AssemblyLinearVelocity =
                        Vector3.zero

                    Root.AssemblyAngularVelocity =
                        Vector3.zero

                    if Alpha >= 1 then
                        break
                    end

                    RunService.Heartbeat:Wait()

                end

                Root.CFrame =
                    TargetCFrame

                print("[EGG FLOW] Arrived at My Plot")

                return true
            end


            --==================================================
            -- FIND PICKUP PROMPT
            --==================================================

            local function FindPickupPrompt(TargetEgg)

                -- First try the original egg
                if TargetEgg and TargetEgg.Parent then

                    for _, Object in
                        ipairs(TargetEgg:GetDescendants())
                    do

                        if Object:IsA("ProximityPrompt") then

                            local ActionText =
                                string.lower(
                                    tostring(Object.ActionText or "")
                                )

                            if string.find(
                                ActionText,
                                "pick",
                                1,
                                true
                            ) then

                                return Object

                            end
                        end
                    end
                end


                --==================================================
                -- IF THE SERVER RECREATED THE EGG,
                -- SEARCH FOR THE SAME EGG NEAR THE DROP LOCATION
                --==================================================

                local TargetName =
                    TargetEgg and TargetEgg.Name

                if not TargetName then
                    return nil
                end

                local Character =
                    Player.Character

                local Root =
                    Character
                    and Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if not Root then
                    return nil
                end

                local BestPrompt = nil
                local BestDistance = math.huge

                for _, Object in
                    ipairs(workspace:GetDescendants())
                do

                    if Object:IsA("ProximityPrompt") then

                        local ActionText =
                            string.lower(
                                tostring(Object.ActionText or "")
                            )

                        if string.find(
                            ActionText,
                            "pick",
                            1,
                            true
                        ) then

                            local Parent =
                                Object.Parent

                            local EggObject = nil

                            while Parent and Parent ~= workspace do

                                if Parent.Name == TargetName then
                                    EggObject = Parent
                                    break
                                end

                                Parent = Parent.Parent

                            end

                            if EggObject then

                                local EggPosition

                                if EggObject:IsA("Model") then

                                    local Okay, Pivot =
                                        pcall(function()
                                            return EggObject:GetPivot()
                                        end)

                                    if Okay then
                                        EggPosition =
                                            Pivot.Position
                                    end

                                elseif EggObject:IsA("BasePart") then

                                    EggPosition =
                                        EggObject.Position

                                end

                                if EggPosition then

                                    local Distance =
                                        (
                                            EggPosition
                                            - Root.Position
                                        ).Magnitude

                                    if Distance < BestDistance then

                                        BestDistance =
                                            Distance

                                        BestPrompt =
                                            Object

                                    end

                                end
                            end
                        end
                    end
                end

                return BestPrompt
            end


            --==================================================
            -- PICK UP THE DROPPED EGG AGAIN
            --==================================================

            local function PickUpEggAgain()

                print("[EGG FLOW] Waiting before re-pickup")

                task.wait(1.5)

                print("[EGG FLOW] Looking for dropped egg")

                local Prompt = nil

                -- Try several times because the server may
                -- need time to recreate the dropped egg.

                for Attempt = 1, 10 do

                    Prompt =
                        FindPickupPrompt(Egg)

                    if Prompt then
                        break
                    end

                    task.wait(0.5)

                end

                if not Prompt then

                    warn(
                        "[EGG FLOW] Could not find pickup prompt for dropped egg"
                    )

                    return false

                end

                print(
                    "[EGG FLOW] Picking egg up again"
                )

                local Okay, Error =
                    pcall(function()

                        fireproximityprompt(
                            Prompt
                        )

                    end)

                if not Okay then

                    warn(
                        "[EGG FLOW] Pickup failed:",
                        Error
                    )

                    return false

                end

                -- Give the server time to equip it
                task.wait(1)

                return true
            end


            
            --==================================================
            -- BLACKLISTED EGG: SKIP VOLCANO
            --==================================================
            if IsBlacklistedEgg(Egg) then

                if SavedPositionTween then

                -- Center Drop ON: go to saved position and drop
                TweenToSavedPosition()
                task.wait(0.5)

                DropEgg()

                return
            end

            -- Center Drop OFF: go to custom drop position
            local Character = Player.Character
                or Player.CharacterAdded:Wait()

            local Root = Character:WaitForChild("HumanoidRootPart")

            Root.CFrame = CFrame.new(81.75, 40315.66, 894.93)

            task.wait(0.5)

            -- Drop the egg at the custom position
            local Dropped = DropEgg()

            if not Dropped then
                warn("[EGG FLOW] Failed to drop blacklisted egg")
                return
            end

            -- Pick up the dropped egg again, then go to the plot
            local PickedUp = PickUpEggAgain()

            if not PickedUp then
                return
            end

            TweenToMyPlot()
                return
            end


            --==================================================
            -- 1. VOLCANO ON + SAVED ON
            --
            -- Pick Up
            -- → Volcano
            -- → Saved
            -- → Drop
            -- → END
            --==================================================

            if VolcanoDipTween
                and SavedPositionTween
            then

                print(
                    "[EGG FLOW] Volcano ON + Saved ON"
                )

                TweenToVolcanoDip()

                task.wait(VolcanoPostDelay)

                TweenToSavedPosition()

                task.wait(0.5)

                DropEgg()

                print(
                    "[EGG FLOW] Finished: Volcano → Saved → Drop"
                )

                return
            end


            --==================================================
            -- 2. VOLCANO ON + SAVED OFF
            --
            -- Pick Up
            -- → Volcano
            -- → Custom Position
            -- → Drop
            -- → wait 1.5 sec
            -- → Pick Up
            -- → Tween My Plot
            --==================================================

            if VolcanoDipTween
                and not SavedPositionTween
            then

                print(
                    "[EGG FLOW] Volcano ON + Saved OFF"
                )

                -- Volcano
                TweenToVolcanoDip()

                task.wait(VolcanoPostDelay)

                -- Custom drop position
                local Character =
                    Player.Character
                    or Player.CharacterAdded:Wait()

                local Root =
                    Character:WaitForChild(
                        "HumanoidRootPart"
                    )

                Root.CFrame =
                    CFrame.new(
                        81.75,
                        40315.66,
                        894.93
                    )

                task.wait(0.5)

                -- Drop
                local Dropped =
                    DropEgg()

                if not Dropped then
                    warn(
                        "[EGG FLOW] Drop failed"
                    )
                    return
                end

                print(
                    "[EGG FLOW] Egg dropped at custom position"
                )

                -- Pick it up again
                local PickedUp =
                    PickUpEggAgain()

                if not PickedUp then
                    return
                end

                -- Tween to plot
                TweenToMyPlot()

                return
            end


            --==================================================
            -- 3. VOLCANO OFF + SAVED ON
            --
            -- Pick Up
            -- → Saved
            -- → Drop
            -- → END
            --==================================================

            if not VolcanoDipTween
                and SavedPositionTween
            then

                print(
                    "[EGG FLOW] Volcano OFF + Saved ON"
                )

                TweenToSavedPosition()

                task.wait(0.5)

                DropEgg()

                print(
                    "[EGG FLOW] Finished: Saved → Drop"
                )

                return
            end


            --==================================================
            -- 4. VOLCANO OFF + SAVED OFF
            --
            -- Pick Up
            -- → Custom Position
            -- → Drop
            -- → wait 1.5 sec
            -- → Pick Up
            -- → Tween My Plot
            --==================================================

            print(
                "[EGG FLOW] Volcano OFF + Saved OFF"
            )

            local Character =
                Player.Character
                or Player.CharacterAdded:Wait()

            local Root =
                Character:WaitForChild(
                    "HumanoidRootPart"
                )

            -- Custom position
            Root.CFrame =
                CFrame.new(
                    81.75,
                    40315.66,
                    894.93
                )

            task.wait(0.5)

            -- Drop
            local Dropped =
                DropEgg()

            if not Dropped then
                warn(
                    "[EGG FLOW] Drop failed"
                )
                return
            end

            print(
                "[EGG FLOW] Egg dropped at custom position"
            )

            -- Pick up again
            local PickedUp =
                PickUpEggAgain()

            if not PickedUp then
                return
            end

            -- Tween to My Plot
            TweenToMyPlot()

        end)


        --==================================================
        -- ERROR HANDLING
        --==================================================

        if not Success then

            warn(
                "[EGG FLOW ERROR]",
                ErrorMessage
            )

        end

        PostPickupRunning = false

    end)
end

