                    )

                    task.wait(0.8)

                --==================================================
                -- VOLCANIC / BLOOM EGG REVERSE TELEPORT
                -- 4 → 3 → 2 → 1
                --==================================================

                if tostring(Egg.Name) == "Volcanic Egg"
                    then

                local Location1 = CFrame.new(
                    -4732.12,
                    41678.94,
                    -3945.08
                )

                local Location2 = CFrame.new(
                    -4904.99,
                    41296.87,
                    -3726.62
                )

                local Location3 = CFrame.new(
                    -4984.83,
                    41288.56,
                    -3625.90
                )

                local Location4 = CFrame.new(
                    -5042.11,
                    41271.99,
                    -3520.53
                )

                local Speed = 250

                --==================================================
                -- REFRESH CHARACTER / HRP
                --==================================================

                local Character =
                    Player.Character

                if not Character then
                    task.wait(0.5)
                    continue
                end

                HRP =
                    Character:FindFirstChild(
                        "HumanoidRootPart"
                )

                if not HRP then
                    task.wait(0.5)
                    continue
                end

                --==================================================
                -- REVERSE TWEEN FUNCTION
                --==================================================

                local function TweenBack(TargetCFrame)

                while AutoEggPickup
                    and HRP
                    and HRP.Parent
                    and (
                        HRP.Position
                        - TargetCFrame.Position
                    ).Magnitude > 5
                 do

                 local Direction =
                    (
                        TargetCFrame.Position
                        - HRP.Position
                    ).Unit

                 local dt = task.wait()

                 HRP.CFrame = CFrame.new(
                     HRP.Position
                         + Direction * Speed * dt,
                     TargetCFrame.Position
                )
             end

            if AutoEggPickup
                and HRP
                and HRP.Parent
            then

                HRP.CFrame =
                    TargetCFrame

                task.wait(1.5)
            end
        end

                --==================================================
                -- REVERSE PATH
                -- 4 → 3 → 2 → 1
                --==================================================

                TweenBack(Location4)

                if not AutoEggPickup then
                    break
                end

                TweenBack(Location3)

                if not AutoEggPickup then
                    break
                end

                TweenBack(Location2)

                if not AutoEggPickup then
                    break
                end

                TweenBack(Location1)

                if not AutoEggPickup then
                    break
                end

            end

                   --==================================================
                    -- POST PICKUP FLOW
                    --==================================================

                    RunAfterEggPickup(Egg)

                    while PostPickupRunning
                        and AutoEggPickup
                    do
                        task.wait(0.1)
                    end

                    if not AutoEggPickup then
                        break
                    end


                    --==================================================
                    -- RESCAN AFTER DROP
                    --==================================================

                    ScanEggs()

                    task.wait(0.3)

                else

                    task.wait(0.5)

                end
            end
        end)
    end
