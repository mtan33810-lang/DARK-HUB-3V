local function TeleportToMyPlot()

    local Character =
        Player.Character
        or Player.CharacterAdded:Wait()

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    --==============================================
    -- FIND MY PLOT
    --==============================================

    local Plot =
        FindMyPlot()

    if not Plot then
        return false
    end

    --==============================================
    -- GET PLOT POSITION
    --==============================================

    local PlotCFrame =
        GetPlotCFrame(Plot)

    if not PlotCFrame then
        return false
    end

        --==============================================
    -- TELEPORT TO MY PLOT FIRST
    --==============================================

    Root.CFrame =
        PlotCFrame + Vector3.new(0, 5, 0)

    task.wait(0.1)

    Window:Notify({
    title = "My Plot",
    content = "Teleported to your plot.",
    duration = 2,
    icon = 7733960981
})

    --==============================================
    -- THEN UNEQUIP EGG
    --==============================================

    task.wait(0.3)

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then

        local EquippedTool =
            Character:FindFirstChildOfClass("Tool")

        if EquippedTool then

            local ToolName =
                string.lower(EquippedTool.Name)

            -- Only unequip tools containing "egg"
            if string.find(ToolName, "egg", 1, true) then

                Humanoid:UnequipTools()

            end
        end
    end

    return true
end


