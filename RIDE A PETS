    if not SelectedESPEggs[EggName] then
        return
    end

    --==================================================
    -- DO NOT ESP EGGS INSIDE PLOTS
    --==================================================

    if IsEggInsidePlot(Egg) then
        return
    end

    --==================================================
    -- VALID EGG OBJECT
    --==================================================

    if not Egg:IsA("Model")
        and not Egg:IsA("BasePart")
    then
        return
    end

    --==================================================
    -- FIND ADORNEE
    --==================================================

    local Adornee

    if Egg:IsA("Model") then

        Adornee =
            Egg.PrimaryPart
            or Egg:FindFirstChildWhichIsA("BasePart")

    else

        Adornee = Egg

    end

    if not Adornee then
        return
    end

    --==================================================
    -- UNIQUE ESP ID
    --==================================================

    local ESPName = Egg:GetDebugId()

    if EggESPFolder:FindFirstChild(ESPName) then
        return
    end

    --==================================================
    -- BILLBOARD
    --==================================================

    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = ESPName
    Billboard.Adornee = Adornee
    Billboard.Size = UDim2.new(0, 180, 0, 40)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = EggESPFolder

    --==================================================
    -- TEXT
    --==================================================

    local Text = Instance.new("TextLabel")

    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1

    Text.Text = "🥚 " .. Egg.Name

    Text.TextColor3 = GetEggESPColor(Egg.Name)

    Text.TextStrokeTransparency = 0
    Text.TextScaled = false
    Text.TextSize = 14
    Text.Font = Enum.Font.GothamBold
    Text.Parent = Billboard

end

