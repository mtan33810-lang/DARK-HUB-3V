local EggColors = {}

local ESPColors = {
    Color3.fromRGB(255, 80, 80),
    Color3.fromRGB(80, 170, 255),
    Color3.fromRGB(100, 255, 140),
    Color3.fromRGB(255, 210, 70),
    Color3.fromRGB(200, 100, 255),
    Color3.fromRGB(255, 120, 200),
    Color3.fromRGB(80, 240, 220),
    Color3.fromRGB(255, 150, 70),
    Color3.fromRGB(180, 180, 255),
    Color3.fromRGB(120, 255, 255)
}

local function GetEggESPColor(EggName)

    if EggColors[EggName] then
        return EggColors[EggName]
    end

    local Number = 0

    for Character in EggName:gmatch(".") do
        Number += string.byte(Character)
    end

    local Index = (Number % #ESPColors) + 1

    EggColors[EggName] = ESPColors[Index]

    return EggColors[EggName]
end

--==================================================
