local SavedEggIgnoreRadius = 20

local function IsNearSavedPosition(EggObject)
    local EggCFrame = GetObjectCFrame(EggObject)

    if not EggCFrame then
        return false
    end

    return (EggCFrame.Position - SAVED_POSITION.Position).Magnitude
        <= SavedEggIgnoreRadius
end

--==================================================
-- SCAN EGGS
--==================================================

local function ScanEggs()

    EggData = {}

    EggsByRarity = {}

    for _, Rarity in ipairs(RarityOrder) do
        EggsByRarity[Rarity] = {}
    end

    local SeenEggs = {}
    local EggCounts = {}

    for _, Object in ipairs(workspace:GetDescendants()) do

        local EggObject, EggName =
            GetEggObject(Object)

        if EggObject
    and EggName
    and not SeenEggs[EggObject]
    and not IsInsidePlot(EggObject)
    and not IsIgnoredDroppedEgg(EggObject)
    and not IsEggHeldByPlayer(EggObject)
    and not IsEggEquipped(EggObject)
    and not IsNearSavedPosition(EggObject)
then

            local ObjectCFrame =
                GetObjectCFrame(EggObject)

            local Rarity =
                EggRarity[EggName]

            -- Only accept eggs that have:
            -- 1. A valid rarity
            -- 2. A valid CFrame
            if ObjectCFrame
                and Rarity
                and EggsByRarity[Rarity]
            then

                SeenEggs[EggObject] = true

                EggCounts[EggName] =
                    (EggCounts[EggName] or 0) + 1

                local Number =
                    EggCounts[EggName]

                local DisplayName =
                    EggName .. " #" .. Number

                local Data = {
                    Object = EggObject,
                    CFrame = ObjectCFrame,
                    EggName = EggName,
                    Rarity = Rarity,
                    Number = Number
                }

                EggData[DisplayName] = Data

                table.insert(
                    EggsByRarity[Rarity],
                    Data
                )
            end
        end
    end

    --==================================================
    -- SORT EGGS
    --==================================================

    for _, EggList in pairs(EggsByRarity) do

        table.sort(
            EggList,
            function(A, B)

                if A.EggName == B.EggName then
                    return A.Number < B.Number
                end

                return A.EggName < B.EggName
            end
        )
    end

    --==================================================
    -- UPDATE DROPDOWN
    --==================================================

    if RarityDropdown then

        local Options = {}
        local KeptSelections = {}

        for _, Rarity in ipairs(RarityOrder) do

            local Count =
                #(EggsByRarity[Rarity] or {})

            local FormattedOption =
                Rarity .. " (" .. Count .. ")"

            table.insert(
                Options,
                FormattedOption
            )

            if SelectedRarities[Rarity] then

                table.insert(
                    KeptSelections,
                    FormattedOption
                )
            end
        end

        RarityDropdown:Refresh(Options)

        if #KeptSelections > 0 then
            RarityDropdown:Set(KeptSelections)
        end
    end

    --==================================================
    -- DEBUG
    --==================================================

    local TotalEggs = 0

    for _, Rarity in ipairs(RarityOrder) do

        local Count =
            #(EggsByRarity[Rarity] or {})

        TotalEggs =
            TotalEggs + Count

        print(
            "[EGG SCANNER]",
            Rarity,
            Count
        )
    end

    print(
        "[EGG SCANNER] Total valid eggs:",
        TotalEggs
    )
end

    --==================================================
    -- GET SELECTED EGGS
    --==================================================

    local function GetSelectedEggsList()

        local CombinedList = {}

        for Rarity, Selected in pairs(SelectedRarities) do

            if Selected
                and EggsByRarity[Rarity]
            then

                for _, Data in ipairs(
                    EggsByRarity[Rarity]
                ) do

                    if Data
                        and Data.Object
                        and Data.Object.Parent
                        and not IsIgnoredDroppedEgg(
                            Data.Object
                        )
                        and not IsEggEquipped(
                            Data.Object
                        )
                    then

                        table.insert(
                            CombinedList,
                            Data
                        )
                    end
                end
            end
        end

        return CombinedList
    end

