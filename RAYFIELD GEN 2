-- Excludes ALL eggs inside plots
--==================================================

local EggESPEnabled = false

local EggESPFolder = Instance.new("Folder")
EggESPFolder.Name = "DARK_HUB_EggESP"
EggESPFolder.Parent = workspace

local EggColors = {}

local ESPColors = {
    Color3.fromRGB(255, 80, 80),
    Color3.fromRGB(80, 170, 255),
    Color3.fromRGB(100, 255, 140),
    Color3.fromRGB(255, 210, 70),
    Color3.fromRGB(200, 100, 255),
    Color3.fromRGB(255, 120, 200),
    Color3.fromRGB(80, 240, 220),
    Color3.fromRGB(255, 150, 70),
    Color3.fromRGB(180, 180, 255),
    Color3.fromRGB(120, 255, 255)
}

local function GetEggESPColor(EggName)

    if EggColors[EggName] then
        return EggColors[EggName]
    end

    local Number = 0

    for Character in EggName:gmatch(".") do
        Number += string.byte(Character)
    end

    local Index = (Number % #ESPColors) + 1

    EggColors[EggName] = ESPColors[Index]

    return EggColors[EggName]
end

--==================================================
-- CHECK IF EGG IS INSIDE ANY PLOT
--==================================================

local function IsEggInsidePlot(Egg)

    local PlotsFolder = workspace:FindFirstChild("Plots")

    if not PlotsFolder then
        return false
    end

    for _, Plot in ipairs(PlotsFolder:GetChildren()) do

        if Egg:IsDescendantOf(Plot) then
            return true
        end

    end

    return false
end

--==================================================
-- CREATE EGG ESP
--==================================================

local function CreateEggESP(Egg)

    if not EggESPEnabled then
        return
    end

    -- 🚫 Do not ESP ANY egg inside a plot
    if IsEggInsidePlot(Egg) then
        return
    end

    if not Egg:IsA("Model") and not Egg:IsA("BasePart") then
        return
    end

    local Adornee

    if Egg:IsA("Model") then

        Adornee =
            Egg.PrimaryPart
            or Egg:FindFirstChildWhichIsA("BasePart")

    else

        Adornee = Egg

    end

    if not Adornee then
        return
    end

    local ESPName = Egg:GetDebugId()

    if EggESPFolder:FindFirstChild(ESPName) then
        return
    end

    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = ESPName
    Billboard.Adornee = Adornee
    Billboard.Size = UDim2.new(0, 180, 0, 40)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = EggESPFolder

    local Text = Instance.new("TextLabel")

    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1

    -- Egg name only
    Text.Text = "🥚 " .. Egg.Name

    -- Different color for each egg name
    Text.TextColor3 = GetEggESPColor(Egg.Name)

    Text.TextStrokeTransparency = 0
    Text.TextScaled = false
    Text.TextSize = 14
    Text.Font = Enum.Font.GothamBold
    Text.Parent = Billboard
end

