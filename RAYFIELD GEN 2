local function DropEgg()

    local Remotes =
        ReplicatedStorage:FindFirstChild("Remotes")

    if not Remotes then
        return false
    end

    local GameRemotes =
        Remotes:FindFirstChild("Game")

    if not GameRemotes then
        return false
    end

    local BasketDrop =
        GameRemotes:FindFirstChild("BasketDrop")

    if not BasketDrop then
        return false
    end

    local Success, ErrorMessage =
        pcall(function()
            BasketDrop:FireServer()
        end)

    if not Success then
        return false
    end

    return true
end

--==================================================
-- POST EGG PICKUP FLOW
--==================================================

local VolcanoPostDelay = 10
local EggDropPostDelay = 5

local function RunAfterEggPickup(Egg)

    if PostPickupRunning then
        return
    end

    PostPickupRunning = true

    task.spawn(function()

        local Success, ErrorMessage =
            pcall(function()

                --==================================================
                -- BLACKLISTED EGG
                -- SKIP VOLCANO COMPLETELY
                --==================================================

                if IsBlacklistedEgg(Egg) then

                    --==============================================
                    -- BLACKLIST + SAVED POSITION
                    -- Pick Up → Saved → Drop
                    --==============================================

                    if SavedPositionTween then

                        local SavedSuccess =
                            TweenToSavedPosition()

                        if not SavedSuccess then
                            return
                        end

                        task.wait(0.5)

                        local DropSuccess =
                            DropEgg()

                        if DropSuccess then
                            MarkEggAsDropped(Egg)
                            task.wait(EggDropPostDelay)
                        end

                    --==============================================
                    -- BLACKLIST + NO SAVED POSITION
                    -- Pick Up → My Plot
                    --==============================================

                    else

                        TeleportToMyPlot()

                    end

                    return
                end

                --==================================================
                -- NORMAL EGG
                --==================================================

                if VolcanoDipTween and SavedPositionTween then

                    -- 1. Volcano
                    local VolcanoSuccess =
                        TweenToVolcanoDip()

                    if not VolcanoSuccess then
                        return
                    end

                    -- 2. Wait at volcano
                    task.wait(VolcanoPostDelay)

                    -- 3. Saved position
                    local SavedSuccess =
                        TweenToSavedPosition()

                    if not SavedSuccess then
                        return
                    end

                    task.wait(0.5)

                    -- 4. Drop
                    local DropSuccess =
                        DropEgg()

                    if DropSuccess then
                        MarkEggAsDropped(Egg)
                        task.wait(EggDropPostDelay)
                    end

                elseif VolcanoDipTween
                    and not SavedPositionTween then

                    -- 1. Volcano
                    local VolcanoSuccess =
                        TweenToVolcanoDip()

                    if not VolcanoSuccess then
                        return
                    end

                    -- 2. Wait at volcano
                    task.wait(VolcanoPostDelay)

                    -- 3. My plot
                    TeleportToMyPlot()

                elseif not VolcanoDipTween
                    and SavedPositionTween then

                    -- 1. Saved
                    local SavedSuccess =
                        TweenToSavedPosition()

                    if not SavedSuccess then
                        return
                    end

                    task.wait(0.5)

                    -- 2. Drop
                    local DropSuccess =
                        DropEgg()

                    if DropSuccess then
                        MarkEggAsDropped(Egg)
                        task.wait(EggDropPostDelay)
                    end

                else

                    -- My Plot
                    TeleportToMyPlot()

                end

            end)

        --==================================================
        -- ERROR HANDLING
        --==================================================

        if not Success then
            warn(
                "[EGG FLOW ERROR]",
                ErrorMessage
            )
        end

        PostPickupRunning = false

    end)
end

