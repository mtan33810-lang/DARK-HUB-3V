--==================================================
-- FORMAT EGG NAME
--==================================================

local function FormatEggName(Name)

    Name = tostring(Name or "")

    Name = Name:gsub("_", " ")
    Name = Name:gsub("%s+", " ")
    Name = Name:gsub("^%s+", "")
    Name = Name:gsub("%s+$", "")

    return Name
end

--==================================================
-- GET OBJECT CFRAME
--==================================================

local function GetObjectCFrame(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.CFrame

    elseif Object:IsA("Model") then

        local Success, Pivot =
            pcall(function()
                return Object:GetPivot()
            end)

        if Success then
            return Pivot
        end
    end

    return nil
end

--==================================================
-- CHECK IF INSIDE PLOT
--==================================================

local function IsInsidePlot(Object)

    if not Object then
        return false
    end

    local Current = Object.Parent

    while Current and Current ~= workspace do

        local Name =
            string.lower(Current.Name)

        if string.find(Name, "plot", 1, true)
            or string.find(Name, "farm", 1, true)
            or string.find(Name, "garden", 1, true)
        then
            return true
        end

        Current = Current.Parent
    end

    return false
end

--==================================================
-- GET ACTUAL EGG CONTAINER
--==================================================

local function GetEggObject(Object)

    local Current = Object

    while Current and Current ~= workspace do

        local FormattedName =
            FormatEggName(Current.Name)

        if ValidEggNames[FormattedName] then
            return Current, FormattedName
        end

        Current = Current.Parent
    end

    return nil, nil
end

--==================================================
-- CHECK CURRENTLY EQUIPPED EGG
--==================================================

local function IsEggEquipped(EggObject)

    if not EggObject then
        return false
    end

    local Character = Player.Character

    if not Character then
        return false
    end

    if EggObject:IsDescendantOf(Character) then
        return true
    end

    for _, Object in ipairs(Character:GetChildren()) do

        if Object:IsA("Tool") then

            if EggObject == Object
                or EggObject:IsDescendantOf(Object)
            then
                return true
            end

            if EggObject.Name == Object.Name then
                return true
            end
        end
    end

    return false
end

--==================================================
-- SAVED POSITION EGG FILTER
--==================================================

local SavedEggIgnoreRadius = 20

local function IsNearSavedPosition(EggObject)
    local EggCFrame = GetObjectCFrame(EggObject)

    if not EggCFrame then
        return false
    end

    return (EggCFrame.Position - SAVED_POSITION.Position).Magnitude
        <= SavedEggIgnoreRadius
end

--==================================================
-- SCAN EGGS
--==================================================

local function ScanEggs()

    EggData = {}

    EggsByRarity = {}

    for _, Rarity in ipairs(RarityOrder) do
        EggsByRarity[Rarity] = {}
    end

    local SeenEggs = {}
    local EggCounts = {}

    for _, Object in ipairs(workspace:GetDescendants()) do

        local EggObject, EggName =
            GetEggObject(Object)

        if EggObject
    and EggName
    and not SeenEggs[EggObject]
    and not IsInsidePlot(EggObject)
    and not IsIgnoredDroppedEgg(EggObject)
    and not IsEggHeldByPlayer(EggObject)
    and not IsEggEquipped(EggObject)
    and not IsNearSavedPosition(EggObject)
then

            local ObjectCFrame =
                GetObjectCFrame(EggObject)

            local Rarity =
                EggRarity[EggName]

            -- Only accept eggs that have:
            -- 1. A valid rarity
            -- 2. A valid CFrame
            if ObjectCFrame
                and Rarity
                and EggsByRarity[Rarity]
            then

                SeenEggs[EggObject] = true

                EggCounts[EggName] =
                    (EggCounts[EggName] or 0) + 1

                local Number =
                    EggCounts[EggName]

                local DisplayName =
                    EggName .. " #" .. Number

                local Data = {
                    Object = EggObject,
                    CFrame = ObjectCFrame,
                    EggName = EggName,
                    Rarity = Rarity,
                    Number = Number
                }

                EggData[DisplayName] = Data

                table.insert(
                    EggsByRarity[Rarity],
                    Data
                )
            end
        end
    end

    --==================================================
    -- SORT EGGS
    --==================================================

    for _, EggList in pairs(EggsByRarity) do

        table.sort(
            EggList,
            function(A, B)

                if A.EggName == B.EggName then
                    return A.Number < B.Number
                end

                return A.EggName < B.EggName
            end
        )
    end

    --==================================================
    -- UPDATE DROPDOWN
    --==================================================

    if RarityDropdown then

        local Options = {}
        local KeptSelections = {}

        for _, Rarity in ipairs(RarityOrder) do

            local Count =
                #(EggsByRarity[Rarity] or {})

            local FormattedOption =
                Rarity .. " (" .. Count .. ")"

            table.insert(
                Options,
                FormattedOption
            )

            if SelectedRarities[Rarity] then

                table.insert(
                    KeptSelections,
                    FormattedOption
                )
            end
        end

        RarityDropdown:Refresh(Options)

        if #KeptSelections > 0 then
            RarityDropdown:Set(KeptSelections)
        end
    end

    --==================================================
    -- DEBUG
    --==================================================

    local TotalEggs = 0

    for _, Rarity in ipairs(RarityOrder) do

        local Count =
            #(EggsByRarity[Rarity] or {})

        TotalEggs =
            TotalEggs + Count

        print(
            "[EGG SCANNER]",
            Rarity,
            Count
        )
    end

    print(
        "[EGG SCANNER] Total valid eggs:",
        TotalEggs
    )
end

