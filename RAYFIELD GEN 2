local function getTeamIdentifier(player)
    if not player then
        return nil
    end

    local character = player.Character

    -- 1. Standard Roblox Team
    if player.Team ~= nil then
        return "TEAM:" .. player.Team.Name
    end

    -- 2. Player attributes
    local team = player:GetAttribute("Team")
    if team ~= nil then
        return "PLAYER_TEAM:" .. tostring(team)
    end

    local teamColor = player:GetAttribute("TeamColor")
    if teamColor ~= nil then
        return "PLAYER_COLOR:" .. tostring(teamColor)
    end

    -- 3. Character attributes
    if character then
        local charTeam = character:GetAttribute("Team")
        if charTeam ~= nil then
            return "CHAR_TEAM:" .. tostring(charTeam)
        end

        local charTeamColor = character:GetAttribute("TeamColor")
        if charTeamColor ~= nil then
            return "CHAR_COLOR:" .. tostring(charTeamColor)
        end

        local squad = character:GetAttribute("Squad")
        if squad ~= nil then
            return "CHAR_SQUAD:" .. tostring(squad)
        end
    end

    return nil
end

local function isSameTeam(player)
    if not player or player == LocalPlayer then
        return false
    end

    local character = player.Character
    if not character then
        return false
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return false
    end

    -- TeammateLabel identifies teammates
    local teammateLabel = root:FindFirstChild("TeammateLabel")

    if teammateLabel then
        return true
    end

    return false
end

local function isValidPlayerTarget(player)
    if not player or player == LocalPlayer then
        return false
    end

    local localChar = LocalPlayer.Character
    local targetChar = player.Character

    if not localChar or not targetChar then
        return false
    end

    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")

    local targetPart =
        targetChar:FindFirstChild(Settings.TargetPart)
        or targetChar:FindFirstChild("HumanoidRootPart")

    if not humanoid or not targetPart or humanoid.Health <= 0 then
        return false
    end

    --========================================================
    -- TEAM CHECK
    --========================================================

    if Settings.TeamCheck and isSameTeam(player) then
        return false
    end

    return true
end

--============================================================
-- WALL CHECK
--============================================================

local function isVisible(targetPart)
    if not Settings.WallCheck then
        return true
    end

    local character = targetPart and targetPart.Parent
    if not targetPart or not character then
        return false
    end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    wallCheckParams.FilterDescendantsInstances = {
        LocalPlayer.Character,
        character
    }

    local result = Workspace:Raycast(
        origin,
        direction,
        wallCheckParams
    )

    -- Nothing blocked the path
    if not result then
        return true
    end

    -- If the ray somehow hits the target character,
    -- the target is still visible.
    if result.Instance:IsDescendantOf(character) then
        return true
    end

    -- Something else, such as a wall, blocked the target.
    return false
end

--============================================================
-- STABLE AIM TARGET SELECTOR
--============================================================

local function getAimTarget()
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)

    local closest = nil
    local closestDistance = Settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayerTarget(player) then
            local character = player.Character
            local targetPart = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart")

            if targetPart and isVisible(targetPart) then
                local position, visible = Camera:WorldToViewportPoint(targetPart.Position)

                -- Ensure target is strictly in front of camera
                if visible and position.Z > 0 then
                    local distance = (Vector2.new(position.X, position.Y) - center).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    return closest
end

