--============================================================
-- HIGH PERFORMANCE ESP LOOP
--============================================================

RunService.RenderStepped:Connect(function()
    if not Settings.ESPEnabled then return end

    local character = getCharacter()
    local localRoot = getRoot(character)
    if not localRoot then return end

    local viewportSize = Camera.ViewportSize
    local originX, originY = viewportSize.X * 0.5, viewportSize.Y
    if Settings.TracerOrigin == "Center" then
        originY = viewportSize.Y * 0.5
    elseif Settings.TracerOrigin == "Top" then
        originY = 0
    end
    local tracerOrigin = Vector2.new(originX, originY)

    for player, drawings in pairs(ESPCache) do
        if not isValidPlayerTarget(player) then
            hideESP(drawings)
            continue
        end

        local targetCharacter = player.Character
        local root = targetCharacter:FindFirstChild("HumanoidRootPart")
        local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")

        if not root or not humanoid then
            hideESP(drawings)
            continue
        end

        local screenPosition, visible = Camera:WorldToViewportPoint(root.Position)
        if not visible then
            hideESP(drawings)
            continue
        end

        if Settings.ESPBoxes then
            local cf = root.CFrame
            local sizeX, sizeY, sizeZ = 2, 3, 2

            local screenCorners = table.create(8)
            local allVisible = true

            for i = 1, 8 do
                local offsetX = (i == 1 or i == 4 or i == 5 or i == 8) and -sizeX or sizeX
                local offsetY = (i <= 4) and sizeY or -sizeY
                local offsetZ = (i == 1 or i == 2 or i == 5 or i == 6) and -sizeZ or sizeZ

                local pos, vis = Camera:WorldToViewportPoint((cf * CFrame.new(offsetX, offsetY, offsetZ)).Position)
                if not vis then allVisible = false break end
                screenCorners[i] = Vector2.new(pos.X, pos.Y)
            end

            if allVisible then
                for i = 1, 12 do
                    local line = drawings.Lines[i]
                    local conn = boxConnections[i]
                    line.From = screenCorners[conn[1]]
                    line.To = screenCorners[conn[2]]
                    line.Color = Settings.BoxColor
                    line.Thickness = Settings.BoxThickness
                    line.Visible = true
                end
            else
                for i = 1, 12 do drawings.Lines[i].Visible = false end
            end
        else
            for i = 1, 12 do drawings.Lines[i].Visible = false end
        end

        if Settings.ESPTracers then
            drawings.Tracer.From = tracerOrigin
            drawings.Tracer.To = Vector2.new(screenPosition.X, screenPosition.Y)
            drawings.Tracer.Color = Settings.TracerColor
            drawings.Tracer.Thickness = Settings.TracerThickness
            drawings.Tracer.Visible = true
        else
            drawings.Tracer.Visible = false
        end

        local distance = (localRoot.Position - root.Position).Magnitude
        local text = Settings.ESPDistance and string.format("%s [%d studs]", player.Name, math.floor(distance)) or player.Name

        drawings.NameTag.Text = text
        drawings.NameTag.Position = Vector2.new(screenPosition.X, screenPosition.Y - 20)
        drawings.NameTag.Visible = Settings.ESPNames or Settings.ESPDistance

        if Settings.ESPHealth then
            local maxHealth = math.max(humanoid.MaxHealth, 1)
            local healthPercent = math.clamp(humanoid.Health / maxHealth, 0, 1)

            drawings.HealthText.Text = string.format("%d/%d HP", math.floor(humanoid.Health), math.floor(maxHealth))
            drawings.HealthText.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
            drawings.HealthText.Position = Vector2.new(screenPosition.X - 30, screenPosition.Y + 10)
            drawings.HealthText.Visible = true
        else
            drawings.HealthOutline.Visible = false
            drawings.HealthBar.Visible = false
            drawings.HealthText.Visible = false
        end
    end
end)

--============================================================
-- STABLE AIM LOOP (CAMERA PRIORITY)
--============================================================

-- Unbind previous renders if re-executed
pcall(function() RunService:UnbindFromRenderStep("DarkHub_Aimbot") end)

RunService:BindToRenderStep("DarkHub_Aimbot", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    -- FOV Rendering
    if Settings.ShowFOV then
        local viewport = Camera.ViewportSize
        FOVCircle.Position = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
        FOVCircle.Radius = Settings.FOV
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    if not Settings.Aimbot then return end

    -- Acquire or maintain target
    local target = Settings.AimTarget
    if not (Settings.TargetLock and isValidPlayerTarget(target)) then
        target = getAimTarget()
        Settings.AimTarget = target
    end

    if not target or not target.Character then return end

    local targetPart = target.Character:FindFirstChild(Settings.TargetPart) or target.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart or not targetPart.Parent then
        Settings.AimTarget = nil
        return
    end

    -- Smooth CFrame Interpolation aligned to Camera step
    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
    local lerpFactor = math.clamp(Settings.Smoothness * (deltaTime * 60), 0.01, 1)
    
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, lerpFactor)
end)

