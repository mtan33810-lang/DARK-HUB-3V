--==================================================
-- INSTANT TELEPORT TO VOLCANO + DIP
--==================================================

local function TweenToVolcanoDip()

    if not VolcanoDipTween then
        return false
    end

    local Character =
        Player.Character
        or Player.CharacterAdded:Wait()

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    Root.CFrame =
        VOLCANO_POSITION

    task.wait(0.5)

    local Packages =
        ReplicatedStorage:FindFirstChild("packages")

    local Net =
        Packages and Packages:FindFirstChild("Net")

    local Event =
        Net and Net:FindFirstChild("RE/VolcanoDip")

    if Event then

        Event:FireServer()

    end

    return true
end


