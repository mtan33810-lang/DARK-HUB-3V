--==================================================
-- EGG BLACKLIST
-- Blacklisted eggs are still picked up,
-- but they SKIP the Volcano.
--==================================================

local BlacklistedEggs = {}

local function IsBlacklistedEgg(Egg)
    if not Egg then
        return false
    end

    local Name = tostring(Egg.Name or "")

    Name = Name:gsub("_", " ")
    Name = Name:gsub("%s+", " ")
    Name = Name:gsub("^%s+", "")
    Name = Name:gsub("%s+$", "")

    return BlacklistedEggs[Name] == true
end

--==================================================
-- FIND MY PLOT
--==================================================

local function FindMyPlot()

    local PlotsFolder =
        workspace:FindFirstChild("Plots")

    if not PlotsFolder then
        return nil
    end

    for _, Plot in ipairs(PlotsFolder:GetChildren()) do

        local Data =
            Plot:FindFirstChild("Data")

        local Owner =
            Data and Data:FindFirstChild("Owner")

        -- StringValue
        if Owner and Owner:IsA("StringValue") then

            if Owner.Value == Player.Name then
                return Plot
            end
        end

        -- ObjectValue
        if Owner and Owner:IsA("ObjectValue") then

            if Owner.Value == Player then
                return Plot
            end
        end

        -- Attribute fallback
        local NestsOwnerLoaded =
            Plot:GetAttribute("NestsOwnerLoaded")

        if NestsOwnerLoaded == Player.UserId then
            return Plot
        end
    end

    return nil
end

--==================================================
-- REMOVE OTHER PLAYER PLOTS
--==================================================

local RemovedPlots = {}

local function RemoveOtherPlayerPlots()

    local PlotsFolder =
        workspace:FindFirstChild("Plots")

    if not PlotsFolder then
        return
    end

    local MyPlot =
        FindMyPlot()

    if not MyPlot then
        return
    end

    local Count = 0

    for _, Plot in ipairs(PlotsFolder:GetChildren()) do

        if Plot ~= MyPlot then

            RemovedPlots[Plot] = true
            Plot.Parent = nil

            Count += 1

        end
    end
    Window:Notify({
    title = "🧹 Plots Removed",
    content = "Removed " .. Count .. " other player plot(s). Your plot was protected.",
    duration = 4,
})
end


--==================================================
-- GET PLOT POSITION
--==================================================

local function GetPlotCFrame(Plot)

    if not Plot then
        return nil
    end

    local PreferredNames = {
        "SpawnLocation",
        "Spawn",
        "PlotSpawn",
        "Main",
        "Base"
    }

    for _, Name in ipairs(PreferredNames) do

        local Part =
            Plot:FindFirstChild(Name, true)

        if Part and Part:IsA("BasePart") then
            return Part.CFrame
        end
    end

    -- Model / BasePart pivot fallback
    local Success, Pivot =
        pcall(function()
            return Plot:GetPivot()
        end)

    if Success then
        return Pivot
    end

    return nil
end


--==================================================
-- TELEPORT TO MY PLOT → UNEQUIP EGG
--==================================================

local function TeleportToMyPlot()

    local Character =
        Player.Character
        or Player.CharacterAdded:Wait()

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    --==============================================
    -- FIND MY PLOT
    --==============================================

    local Plot =
        FindMyPlot()

    if not Plot then
        return false
    end

    --==============================================
    -- GET PLOT POSITION
    --==============================================

    local PlotCFrame =
        GetPlotCFrame(Plot)

    if not PlotCFrame then
        return false
    end

    --==============================================
    -- TELEPORT TO MY PLOT FIRST
    --==============================================

    Root.CFrame =
        PlotCFrame + Vector3.new(0, 5, 0)

    task.wait(0.1)

    Window:Notify({
    title = "My Plot",
    content = "Teleported to your plot.",
    duration = 2,
    icon = 7733960981
})

    --==============================================
    -- THEN UNEQUIP EGG
    --==============================================

    task.wait(0.3)

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then

        local EquippedTool =
            Character:FindFirstChildOfClass("Tool")

        if EquippedTool then

            local ToolName =
                string.lower(EquippedTool.Name)

            -- Only unequip tools containing "egg"
            if string.find(ToolName, "egg", 1, true) then

                Humanoid:UnequipTools()

            end
        end
    end

    return true
end


