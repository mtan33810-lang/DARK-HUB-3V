local ESPCache = {}

local function createESP(player)
    if ESPCache[player] or player == LocalPlayer then return end

    local lines = table.create(12)
    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = Settings.BoxThickness
        line.Color = Settings.BoxColor
        lines[i] = line
    end

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Thickness = Settings.TracerThickness
    tracer.Color = Settings.TracerColor

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Color = Color3.fromRGB(255, 255, 255)

    local healthOutline = Drawing.new("Square")
    healthOutline.Visible = false
    healthOutline.Filled = true
    healthOutline.Color = Color3.fromRGB(0, 0, 0)

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Filled = true

    local healthText = Drawing.new("Text")
    healthText.Visible = false
    healthText.Size = 12
    healthText.Outline = true

    ESPCache[player] = {
        Lines = lines,
        Tracer = tracer,
        NameTag = nameTag,
        HealthOutline = healthOutline,
        HealthBar = healthBar,
        HealthText = healthText
    }
end

local function hideESP(drawings)
    for i = 1, 12 do
        drawings.Lines[i].Visible = false
    end
    drawings.Tracer.Visible = false
    drawings.NameTag.Visible = false
    drawings.HealthOutline.Visible = false
    drawings.HealthBar.Visible = false
    drawings.HealthText.Visible = false
end

local function removeESP(player)
    local drawings = ESPCache[player]
    if not drawings then return end

    for i = 1, 12 do
        drawings.Lines[i]:Remove()
    end
    drawings.Tracer:Remove()
    drawings.NameTag:Remove()
    drawings.HealthOutline:Remove()
    drawings.HealthBar:Remove()
    drawings.HealthText:Remove()

    ESPCache[player] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(createESP, player)
end

