local function ToggleSwitch(on,pill,knob,sk,KW)
    if on then
        TweenService:Create(pill,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(200,0,0)}):Play()
        TweenService:Create(knob,TweenInfo.new(0.2,Enum.EasingStyle.Back),{
            Position=UDim2.new(1,-(KW+3),0.5,-KW/2),
            BackgroundColor3=Color3.fromRGB(255,255,255)
        }):Play()
        TweenService:Create(sk,TweenInfo.new(0.2),{Color=Color3.fromRGB(255,80,80)}):Play()
    else
        TweenService:Create(pill,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(50,15,15)}):Play()
        TweenService:Create(knob,TweenInfo.new(0.2,Enum.EasingStyle.Back),{
            Position=UDim2.new(0,3,0.5,-KW/2),
            BackgroundColor3=Color3.fromRGB(120,40,40)
        }):Play()
        TweenService:Create(sk,TweenInfo.new(0.2),{Color=Color3.fromRGB(80,15,15)}):Play()
    end
end

