    KBBox.TextSize=11; KBBox.Font=Enum.Font.GothamBold
    KBBox.ClearTextOnFocus=true; KBBox.ZIndex=5; KBBox.Parent=KBRow
    Instance.new("UICorner",KBBox).CornerRadius=UDim.new(0,6)
    Instance.new("UIStroke",KBBox).Color=Color3.fromRGB(180,140,0)

    -- ── TOGGLE LOGIC ──
    local function doToggle()
        TweenService:Create(BtnFrame,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(35,28,4)}):Play()
        task.delay(0.15,function()
            TweenService:Create(BtnFrame,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(18,14,2)}):Play()
        end)
        if following then
            -- press again = stop
            StopFollow(StatLbl, KillBtn)
        else
            -- not following = start
            KillRandom(StatLbl, KillBtn)
        end
    end

    KillBtn.MouseButton1Click:Connect(doToggle)

    KBBox.FocusLost:Connect(function()
        local txt=KBBox.Text:upper()
        if txt=="" then KBBox.Text="E"; return end
        local ok,kc=pcall(function() return Enum.KeyCode[txt] end)
        if ok and kc then currentKeybind=kc; KBBox.Text=txt
            KBBox.TextColor3=Color3.fromRGB(255,200,0)
        else KBBox.Text="E"; currentKeybind=Enum.KeyCode.E end
    end)

    UserInputService.InputBegan:Connect(function(i,gp)
        if gp then return end
        if i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==currentKeybind then
            doToggle()
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        StopFollow(StatLbl, KillBtn)
    end)

    return Main
end

