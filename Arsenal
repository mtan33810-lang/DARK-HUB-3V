local function StopFollow(statLbl, killBtn)
    following=false; knifeTarget=nil
    if followConn then followConn:Disconnect(); followConn=nil end
    if statLbl then statLbl.Text="⬤ Ready"; statLbl.TextColor3=Color3.fromRGB(180,120,40) end
    if killBtn then killBtn.Text="🔪  Kill Random" end
end

local function GetRandomEnemy()
    local enemies={}
    for _,p in pairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        if not p.Character then continue end
        if p.Team==LocalPlayer.Team then continue end
        local hum=p.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        if not p.Character:FindFirstChild("HumanoidRootPart") then continue end
        table.insert(enemies,p)
    end
    if #enemies==0 then return nil end
    return enemies[math.random(1,#enemies)]
end

local function StartFollow(targetPlayer, statLbl, killBtn)
    following=false
    if followConn then followConn:Disconnect(); followConn=nil end
    following=true; knifeTarget=targetPlayer
    followConn=RunService.Heartbeat:Connect(function()
        if not following then return end
        if not knifeTarget or not knifeTarget.Character then
            StopFollow(statLbl,killBtn)
            if statLbl then statLbl.Text="⏹ Target lost"; statLbl.TextColor3=Color3.fromRGB(200,80,80) end
            return
        end
        local char=LocalPlayer.Character
        if not char then return end
        local myRoot=char:FindFirstChild("HumanoidRootPart")
        local tRoot=knifeTarget.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot or not tRoot then return end
        local hum=knifeTarget.Character:FindFirstChildOfClass("Humanoid")
        -- auto stop when target dies
        if not hum or hum.Health<=0 then
            StopFollow(statLbl,killBtn)
            if statLbl then statLbl.Text="💀 Target eliminated!"; statLbl.TextColor3=Color3.fromRGB(255,200,0) end
            return
        end
        myRoot.CFrame=tRoot.CFrame*CFrame.new(0,0,2)
        if statLbl then
            statLbl.Text="🔪 "..knifeTarget.Name.." | HP: "..math.floor(hum.Health)
            statLbl.TextColor3=Color3.fromRGB(255,180,40)
        end
    end)
end

local function KillRandom(statLbl, killBtn)
    local enemy=GetRandomEnemy()
    if not enemy then
        statLbl.Text="⚠️ No enemies found!"; statLbl.TextColor3=Color3.fromRGB(255,80,80)
        if killBtn then killBtn.Text="🔪  Kill Random" end
        task.delay(2,function()
            if not following then
                statLbl.Text="⬤ Ready"; statLbl.TextColor3=Color3.fromRGB(180,120,40)
            end
        end)
        return
    end
    statLbl.Text="🔪 Following: "..enemy.Name; statLbl.TextColor3=Color3.fromRGB(255,180,40)
    if killBtn then killBtn.Text="⏹  Stop" end
    StartFollow(enemy,statLbl,killBtn)
end

