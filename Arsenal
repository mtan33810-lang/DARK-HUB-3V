    KillBtn.TextColor3=Color3.fromRGB(255,200,0); KillBtn.TextSize=14
    KillBtn.Font=Enum.Font.GothamBlack; KillBtn.ZIndex=4; KillBtn.Parent=BtnFrame

    -- Keybind row
    local KBRow=Instance.new("Frame"); KBRow.Size=UDim2.new(1,-16,0,26)
    KBRow.Position=UDim2.new(0,8,0,124); KBRow.BackgroundColor3=Color3.fromRGB(16,12,2)
    KBRow.BorderSizePixel=0; KBRow.ZIndex=3; KBRow.Parent=Main
    Instance.new("UICorner",KBRow).CornerRadius=UDim.new(0,8)
    Instance.new("UIStroke",KBRow).Color=Color3.fromRGB(80,60,0)

    local KBLbl=Instance.new("TextLabel"); KBLbl.Size=UDim2.new(0.55,0,1,0)
    KBLbl.Position=UDim2.new(0,10,0,0); KBLbl.BackgroundTransparency=1
