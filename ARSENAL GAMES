local ESPCache = {}

--============================================================
-- CREATE ESP
--============================================================

local function createESP(entity)

    if not entity then
        return
    end

    if entity:IsA("Player") then

        if entity == LocalPlayer then
            return
        end

    elseif entity:IsA("Model") then

        -- FIXED: use isBotModel
        if not isBotModel(entity) then
            return
        end

    else
        return
    end

    if ESPCache[entity] then
        return
    end

    local lines = table.create(12)

    for i = 1, 12 do

        local line = Drawing.new("Line")

        line.Visible = false
        line.Thickness = Settings.BoxThickness
        line.Color = Settings.BoxColor

        lines[i] = line
    end

    local tracer = Drawing.new("Line")

    tracer.Visible = false
    tracer.Thickness = Settings.TracerThickness
    tracer.Color = Settings.TracerColor

    local nameTag = Drawing.new("Text")

    nameTag.Visible = false
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Color =
        Color3.fromRGB(255, 255, 255)

    local distanceTag = Drawing.new("Text")

    distanceTag.Visible = false
    distanceTag.Size = 12
    distanceTag.Center = true
    distanceTag.Outline = true
    distanceTag.Color =
        Color3.fromRGB(0, 170, 255)

    local healthOutline = Drawing.new("Square")

    healthOutline.Visible = false
    healthOutline.Filled = true
    healthOutline.Color =
        Color3.fromRGB(0, 0, 0)

    local healthBar = Drawing.new("Square")

    healthBar.Visible = false
    healthBar.Filled = true

    local healthText = Drawing.new("Text")

    healthText.Visible = false
    healthText.Size = 12
    healthText.Outline = true

    ESPCache[entity] = {

        Lines = lines,

        Tracer = tracer,

        NameTag = nameTag,

        DistanceTag = distanceTag,

        HealthOutline = healthOutline,

        HealthBar = healthBar,

        HealthText = healthText
    }
end

--============================================================
-- HIDE ESP
--============================================================

local function hideESP(drawings)

    if not drawings then
        return
    end

    for i = 1, 12 do
        drawings.Lines[i].Visible = false
    end

    drawings.Tracer.Visible = false
    drawings.NameTag.Visible = false
    drawings.DistanceTag.Visible = false
    drawings.HealthOutline.Visible = false
    drawings.HealthBar.Visible = false
    drawings.HealthText.Visible = false
end

--============================================================
-- REMOVE ESP
--============================================================

local function removeESP(entity)

    local drawings = ESPCache[entity]

    if not drawings then
        return
    end

    for i = 1, 12 do
        drawings.Lines[i]:Remove()
    end

    drawings.Tracer:Remove()
    drawings.NameTag:Remove()
    drawings.DistanceTag:Remove()
    drawings.HealthOutline:Remove()
    drawings.HealthBar:Remove()
    drawings.HealthText:Remove()

    ESPCache[entity] = nil
end

