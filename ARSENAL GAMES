-- AIMBOT RENDER STEP
--============================================================

pcall(function()

    RunService:UnbindFromRenderStep(
        "DarkHub_Aimbot"
    )

end)

RunService:BindToRenderStep(

    "DarkHub_Aimbot",

    Enum.RenderPriority.Camera.Value + 1,

    function(deltaTime)

        --====================================================
        -- FOV
        --====================================================

        if Settings.ShowFOV then

            local viewport =
                Camera.ViewportSize

            FOVCircle.Position =
                Vector2.new(
                    viewport.X * 0.5,
                    viewport.Y * 0.5
                )

            FOVCircle.Radius =
                Settings.FOV

            FOVCircle.Visible =
                true

        else

            FOVCircle.Visible =
                false

        end

        --====================================================
        -- AIMBOT OFF
        --====================================================

        if not Settings.Aimbot then

            Settings.AimTarget = nil

            return
        end

        --====================================================
        -- CURRENT TARGET
        --====================================================

        local target =
            Settings.AimTarget

        --====================================================
        -- TARGET LOCK
        --====================================================

        if Settings.TargetLock then

            if not target then

                target =
                    getAimTarget()

                Settings.AimTarget =
                    target

            elseif target:IsA("Player") then

                if not isValidPlayerTarget(target) then

                    target =
                        getAimTarget()

                    Settings.AimTarget =
                        target
                end

            elseif target:IsA("Model") then

                if not isValidBotTarget(target) then

                    target =
                        getAimTarget()

                    Settings.AimTarget =
                        target
                end

            else

                target =
                    getAimTarget()

                Settings.AimTarget =
                    target
            end

        else

            target =
                getAimTarget()

            Settings.AimTarget =
                target

        end

        if not target then
            return
        end

        --====================================================
        -- TARGET PART
        --====================================================

        local targetPart =
            getCurrentAimPart(target)

        if not targetPart then

            Settings.AimTarget = nil

            return
        end

        --====================================================
        -- SCREEN CHECK
        --====================================================

        local screenPosition, onScreen =
            Camera:WorldToViewportPoint(
                targetPart.Position
            )

        if not onScreen
            or screenPosition.Z <= 0 then

            if Settings.TargetLock then
                Settings.AimTarget = nil
            end

            return
        end

        local viewport =
            Camera.ViewportSize

        if screenPosition.X < 0
            or screenPosition.X > viewport.X
            or screenPosition.Y < 0
            or screenPosition.Y > viewport.Y then

            if Settings.TargetLock then
                Settings.AimTarget = nil
            end

            return
        end

        --====================================================
        -- WALL CHECK
        --====================================================

        if not isVisible(targetPart) then

            if Settings.TargetLock then
                Settings.AimTarget = nil
            end

            return
        end

        --====================================================
        -- CAMERA AIM
        --====================================================

        local cameraPosition =
            Camera.CFrame.Position

        local targetCFrame =
            CFrame.lookAt(
                cameraPosition,
                targetPart.Position
            )

        local smoothness =
            tonumber(
                Settings.Smoothness
            )
            or 0.20

        local lerpFactor =
            math.clamp(
                smoothness
                * (deltaTime * 60),
                0.01,
                1
            )

        Camera.CFrame =
            Camera.CFrame:Lerp(
                targetCFrame,
                lerpFactor
            )
    end
)

