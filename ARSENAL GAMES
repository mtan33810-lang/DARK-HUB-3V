--============================================================
-- ESP LOOP
--============================================================

RunService.RenderStepped:Connect(function()

    if not Settings.ESPEnabled then

        for _, drawings in pairs(ESPCache) do
            hideESP(drawings)
        end

        return
    end

    local character = getCharacter()

    local localRoot =
        getRoot(character)

    if not localRoot then
        return
    end

    local viewportSize =
        Camera.ViewportSize

    local originX =
        viewportSize.X * 0.5

    local originY =
        viewportSize.Y

    if Settings.TracerOrigin == "Center" then

        originY =
            viewportSize.Y * 0.5

    elseif Settings.TracerOrigin == "Top" then

        originY = 0

    end

    local tracerOrigin =
        Vector2.new(
            originX,
            originY
        )

    --========================================================
    -- ENTITY LOOP
    --========================================================

    for entity, drawings in pairs(ESPCache) do

        local valid = false

        -- PLAYER
        if entity:IsA("Player") then

            valid =
                isValidPlayerTarget(entity)

        -- BOT
        elseif entity:IsA("Model") then

            valid =
                Settings.TargetBots
                and isValidBotTarget(entity)

        end

        if not valid then

            hideESP(drawings)

            continue
        end

        local targetCharacter =
            getTargetCharacter(entity)

        if not targetCharacter then

            hideESP(drawings)

            continue
        end

        local root =
            getRoot(targetCharacter)
            or targetCharacter.PrimaryPart
            or targetCharacter:FindFirstChild(
                "UpperTorso"
            )
            or targetCharacter:FindFirstChild(
                "Torso"
            )

        local humanoid =
            getHumanoid(targetCharacter)

        if not root or not humanoid then

            hideESP(drawings)

            continue
        end

        local screenPosition, visible =
            Camera:WorldToViewportPoint(
                root.Position
            )

        if not visible
            or screenPosition.Z <= 0 then

            hideESP(drawings)

            continue
        end

        --====================================================
        -- BOX
        --====================================================

        if Settings.ESPBoxes then

            local cf = root.CFrame

            local sizeX = 2
            local sizeY = 3
            local sizeZ = 2

            local screenCorners =
                table.create(8)

            local allVisible = true

            for i = 1, 8 do

                local offsetX =
                    (
                        i == 1
                        or i == 4
                        or i == 5
                        or i == 8
                    )
                    and -sizeX
                    or sizeX

                local offsetY =
                    i <= 4
                    and sizeY
                    or -sizeY

                local offsetZ =
                    (
                        i == 1
                        or i == 2
                        or i == 5
                        or i == 6
                    )
                    and -sizeZ
                    or sizeZ

                local pos, vis =
                    Camera:WorldToViewportPoint(
                        (
                            cf
                            * CFrame.new(
                                offsetX,
                                offsetY,
                                offsetZ
                            )
                        ).Position
                    )

                if not vis then

                    allVisible = false

                    break
                end

                screenCorners[i] =
                    Vector2.new(
                        pos.X,
                        pos.Y
                    )
            end

            if allVisible then

                for i = 1, 12 do

                    local line =
                        drawings.Lines[i]

                    local conn =
                        boxConnections[i]

                    line.From =
                        screenCorners[
                            conn[1]
                        ]

                    line.To =
                        screenCorners[
                            conn[2]
                        ]

                    line.Color =
                        Settings.BoxColor

                    line.Thickness =
                        Settings.BoxThickness

                    line.Visible = true
                end

            else

                for i = 1, 12 do
                    drawings.Lines[i].Visible =
                        false
                end

            end

        else

            for i = 1, 12 do
                drawings.Lines[i].Visible =
                    false
            end

        end

        --====================================================
        -- TRACER
        --====================================================

        if Settings.ESPTracers then

            drawings.Tracer.From =
                tracerOrigin

            drawings.Tracer.To =
                Vector2.new(
                    screenPosition.X,
                    screenPosition.Y
                )

            drawings.Tracer.Color =
                Settings.TracerColor

            drawings.Tracer.Thickness =
                Settings.TracerThickness

            drawings.Tracer.Visible =
                true

        else

            drawings.Tracer.Visible =
                false

        end

        --====================================================
        -- DISTANCE
        --====================================================

        local distance =
            (
                localRoot.Position
                - root.Position
            ).Magnitude

        --====================================================
        -- NAME
        --====================================================

        drawings.NameTag.Text =
            entity.Name

        drawings.NameTag.Position =
            Vector2.new(
                screenPosition.X,
                screenPosition.Y - 35
            )

        drawings.NameTag.Color =
            Color3.fromRGB(
                255,
                255,
                255
            )

        drawings.NameTag.Visible =
            Settings.ESPNames

        --====================================================
        -- DISTANCE
        --====================================================

        drawings.DistanceTag.Text =
            string.format(
                "[%d studs]",
                math.floor(distance)
            )

        drawings.DistanceTag.Position =
            Vector2.new(
                screenPosition.X,
                screenPosition.Y - 20
            )

        drawings.DistanceTag.Color =
            Color3.fromRGB(
                0,
                170,
                255
            )

        drawings.DistanceTag.Visible =
            Settings.ESPDistance

        --====================================================
        -- HEALTH
        --====================================================

        if Settings.ESPHealth then

            local maxHealth =
                math.max(
                    humanoid.MaxHealth,
                    1
                )

            local healthPercent =
                math.clamp(
                    humanoid.Health
                    / maxHealth,
                    0,
                    1
                )

            drawings.HealthText.Text =
                string.format(
                    "%d/%d HP",
                    math.floor(
                        humanoid.Health
                    ),
                    math.floor(
                        maxHealth
                    )
                )

            drawings.HealthText.Color =
                Color3.fromRGB(
                    255 * (1 - healthPercent),
                    255 * healthPercent,
                    0
                )

            drawings.HealthText.Position =
                Vector2.new(
                    screenPosition.X - 30,
                    screenPosition.Y + 10
                )

            drawings.HealthText.Visible =
                true

        else

            drawings.HealthOutline.Visible =
                false

            drawings.HealthBar.Visible =
                false

            drawings.HealthText.Visible =
                false
        end
    end
end)

