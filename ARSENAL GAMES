    if object:IsA("Model") then

        BotCache[object] = nil

        if Settings.AimTarget == object then
            Settings.AimTarget = nil
        end
    end
end)

--============================================================
-- BOT MONITOR
--============================================================

task.spawn(function()

    while task.wait(0.5) do

        -- Find newly created/recreated bots
        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            if object:IsA("Model")
                and isBotModel(object) then

                if not BotCache[object] then
                    BotCache[object] = true
                end
            end
        end

        -- Remove models that no longer exist
        for bot in pairs(BotCache) do

            if not bot.Parent
                or not isBotModel(bot) then

                BotCache[bot] = nil

                if Settings.AimTarget == bot then
                    Settings.AimTarget = nil
                end
            end
        end
    end
end)

--============================================================
-- TEAM IDENTIFIER 
--============================================================

local function getTeamIdentifier(player)

    if not player then
        return nil
    end

    local character = player.Character

    if player.Team ~= nil then
        return "TEAM:" .. player.Team.Name
    end

    local team = player:GetAttribute("Team")

    if team ~= nil then
        return "PLAYER_TEAM:" .. tostring(team)
    end

    local teamColor = player:GetAttribute("TeamColor")

    if teamColor ~= nil then
        return "PLAYER_COLOR:" .. tostring(teamColor)
    end

    if character then

        local charTeam =
            character:GetAttribute("Team")

        if charTeam ~= nil then
            return "CHAR_TEAM:" .. tostring(charTeam)
        end

        local charTeamColor =
            character:GetAttribute("TeamColor")

        if charTeamColor ~= nil then
            return "CHAR_COLOR:" .. tostring(charTeamColor)
        end

        local squad =
            character:GetAttribute("Squad")

        if squad ~= nil then
            return "CHAR_SQUAD:" .. tostring(squad)
        end
    end

    return nil
end

--============================================================
-- TEAM CHECK
--============================================================

local function isSameTeam(player)
    if not player or player == LocalPlayer then
        return false
    end

    --========================================================
    -- TEAM CHECK #1: Roblox Team
    --========================================================

    if LocalPlayer.Team ~= nil and player.Team ~= nil then
        if LocalPlayer.Team == player.Team then
            return true
        end
    end

    --========================================================
    -- TEAM CHECK #1B: Team Attribute
    --========================================================

    local myTeam = LocalPlayer:GetAttribute("Team")
    local targetTeam = player:GetAttribute("Team")

    if myTeam ~= nil and targetTeam ~= nil then
        if myTeam == targetTeam then
            return true
        end
    end

    --========================================================
    -- TEAM CHECK #2: TeammateLabel
    --========================================================

    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if root and root:FindFirstChild("TeammateLabel") then
        return true
    end

    return false
end


--============================================================
-- PLAYER TARGET VALIDATION
--============================================================

local function isValidPlayerTarget(player)

    if not player or player == LocalPlayer then
        return false
    end

    local localChar = LocalPlayer.Character
    local targetChar = player.Character

    if not localChar or not targetChar then
        return false
    end

    local humanoid =
        targetChar:FindFirstChildOfClass("Humanoid")

    local targetPart =
        targetChar:FindFirstChild(Settings.TargetPart)
        or targetChar:FindFirstChild("HumanoidRootPart")

    if not humanoid or not targetPart then
        return false
    end

    if humanoid.Health <= 0 then
        return false
    end

    if Settings.TeamCheck
        and isSameTeam(player) then

        return false
    end

    return true
end

--============================================================
-- BOT TARGET VALIDATION
--============================================================

local function isValidBotTarget(bot)

    if not Settings.TargetBots then
        return false
    end

    if not isBotModel(bot) then
        return false
    end

    if not isBotAlive(bot) then
        return false
    end

    return getBotTargetPart(bot) ~= nil
end

--============================================================
-- UNIVERSAL TARGET PART
--============================================================

local function getCurrentAimPart(entity)

    if not entity then
        return nil
    end

    if entity:IsA("Player") then

        if not entity.Character then
            return nil
        end

        return entity.Character:FindFirstChild(
            Settings.TargetPart
        )
        or entity.Character:FindFirstChild(
            "HumanoidRootPart"
        )
    end

    if entity:IsA("Model") then
        return getBotTargetPart(entity)
    end

    return nil
end

--============================================================
-- UNIVERSAL CHARACTER
--============================================================

local function getTargetCharacter(entity)

    if not entity then
        return nil
    end

    if entity:IsA("Player") then
        return entity.Character
    end

    if entity:IsA("Model") then
        return entity
    end

    return nil
end

--============================================================
-- WALL CHECK
--============================================================

local function isVisible(targetPart)

    if not Settings.WallCheck then
        return true
    end

    if not targetPart then
        return false
    end

    local character =
        targetPart:FindFirstAncestorOfClass("Model")

    if not character then
        return false
    end

    local origin =
        Camera.CFrame.Position

    local direction =
        targetPart.Position - origin

    wallCheckParams.FilterDescendantsInstances = {
        LocalPlayer.Character,
        character
    }

    local result = Workspace:Raycast(
        origin,
        direction,
        wallCheckParams
    )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(character)
end

--============================================================
-- GET AIM TARGET
--============================================================

local function getAimTarget()

    local viewport =
        Camera.ViewportSize

    local center = Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local closest = nil
    local closestDistance = Settings.FOV

    --========================================================
    -- PLAYERS
    --========================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if isValidPlayerTarget(player) then

            local targetPart =
                getCurrentAimPart(player)

            if targetPart
                and isVisible(targetPart) then

                local position, visible =
                    Camera:WorldToViewportPoint(
                        targetPart.Position
                    )

                if visible and position.Z > 0 then

                    local distance =
                        (
                            Vector2.new(
                                position.X,
                                position.Y
                            ) - center
                        ).Magnitude

                    if distance < closestDistance then

                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    --========================================================
    -- BOTS
    --========================================================

    if Settings.TargetBots then

        for bot in pairs(BotCache) do

            if isValidBotTarget(bot) then

                local targetPart =
                    getCurrentAimPart(bot)

                if targetPart
                    and isVisible(targetPart) then

                    local position, visible =
                        Camera:WorldToViewportPoint(
                            targetPart.Position
                        )

                    if visible and position.Z > 0 then

                        local distance =
                            (
                                Vector2.new(
                                    position.X,
                                    position.Y
                                ) - center
                            ).Magnitude

                        if distance < closestDistance then

                            closestDistance = distance
                            closest = bot
                        end
                    end
                end
            end
        end
    end

    return closest
end

--============================================================
