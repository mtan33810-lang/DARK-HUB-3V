--============================================================
-- UTILITY
--============================================================

local function getCharacter()
    return LocalPlayer.Character
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

--============================================================
-- BOT SYSTEM
--============================================================

local BotCache = {}

local function getBotRoot(bot)

    if not bot then
        return nil
    end

    return bot:FindFirstChild("HumanoidRootPart")
        or bot:FindFirstChild("UpperTorso")
        or bot:FindFirstChild("Torso")
        or bot.PrimaryPart
end

local function getBotTargetPart(bot)

    if not bot then
        return nil
    end

    return bot:FindFirstChild(Settings.TargetPart, true)
        or bot:FindFirstChild("Head", true)
        or getBotRoot(bot)
end

--============================================================
-- IDENTIFY BOT
--============================================================

local function isBotModel(model)

    if not model or not model:IsA("Model") then
        return false
    end

    -- Never treat a real player character as a bot
    if Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid =
        model:FindFirstChildOfClass("Humanoid")

    local root =
        getBotRoot(model)

    if not humanoid or not root then
        return false
    end

    return true
end

--============================================================
-- BOT ALIVE CHECK
--============================================================

local function isBotAlive(bot)

    if not isBotModel(bot) then
        return false
    end

    local humanoid =
        bot:FindFirstChildOfClass("Humanoid")

    return humanoid
        and humanoid.Health > 0
end

--============================================================
-- REGISTER BOT
--============================================================

local function registerBot(bot)

    if not isBotModel(bot) then
        return
    end

    BotCache[bot] = true
end

