--============================================================
-- BOT ESP RESPAWN MONITOR
--============================================================

task.spawn(function()

    while task.wait(0.5) do

        if not Settings.ESPEnabled then
            continue
        end

        if not Settings.TargetBots then
            continue
        end

        for bot in pairs(BotCache) do

            if not bot.Parent then

                removeESP(bot)

            elseif not isBotModel(bot) then

                removeESP(bot)

            elseif not ESPCache[bot] then

                -- Recreate ESP after bot respawn/rebuild
                createESP(bot)
            end
        end
    end
end)

