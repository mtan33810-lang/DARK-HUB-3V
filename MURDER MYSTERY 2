--========================================================
-- ROLE DETECTION
--========================================================

local function GetPlayerRole(plr)
    local backpack = plr:FindFirstChild("Backpack")
    local character = plr.Character

    if not backpack or not character then
        return "Unknown"
    end

    local knife =
        backpack:FindFirstChild("Knife")
        or character:FindFirstChild("Knife")

    local gun =
        backpack:FindFirstChild("Gun")
        or character:FindFirstChild("Gun")

    if knife then
        return "Murderer"
    elseif gun then
        return "Sheriff"
    else
        return "Innocent"
    end
end

local function GetRoleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 50, 50)

    elseif role == "Sheriff" then
        return Color3.fromRGB(50, 130, 255)

    elseif role == "Innocent" then
        return Color3.fromRGB(50, 255, 80)
    end

    return Color3.fromRGB(255, 255, 255)
end

--========================================================
-- ROLE ESP
--========================================================

local function UpdatePlayerESP(plr)
    if plr == lp then
        return
    end

    local character = plr.Character

    if not character then
        return
    end

    local highlight = ESPObjects[plr]

    if not highlight or highlight.Parent ~= character then
        if highlight then
            highlight:Destroy()
        end

        highlight = Instance.new("Highlight")
        highlight.Name = "RoleESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.45
        highlight.OutlineTransparency = 0

        ESPObjects[plr] = highlight
    end

    highlight.Parent = character

    if not getgenv().MM2.RoleESP then
        highlight.Enabled = false
        return
    end

    local role = GetPlayerRole(plr)
    local color = GetRoleColor(role)

    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Enabled = true
end

task.spawn(function()
    while true do
        task.wait(0.25)

        for _, plr in Players:GetPlayers() do
            if plr ~= lp then
                UpdatePlayerESP(plr)
            end
