--//========================================================
--// FLING LOOP
--//========================================================

ServiceConnections.FlingConnection =
    RunService.Heartbeat:Connect(function()

        if Destroyed then
            return
        end

        if not Environment.Settings.FlingTouchToggle then
            return
        end

        local Character, HumanoidRootPart = GetCharacter()

        if not Character
            or not Character.Parent
            or not HumanoidRootPart
            or not HumanoidRootPart.Parent then
            return
        end

        local Velocity = HumanoidRootPart.AssemblyLinearVelocity

        HumanoidRootPart.AssemblyLinearVelocity =
            Velocity * 10000 + Vector3.new(0, 10000, 0)

        RunService.RenderStepped:Wait()

        if Character
            and Character.Parent
            and HumanoidRootPart
            and HumanoidRootPart.Parent then

            HumanoidRootPart.AssemblyLinearVelocity = Velocity
        end

        RunService.Stepped:Wait()

        if Character
            and Character.Parent
            and HumanoidRootPart
            and HumanoidRootPart.Parent then

            HumanoidRootPart.AssemblyLinearVelocity =
                Velocity + Vector3.new(0, movel, 0)

            movel = movel * -1
        end
    end)

