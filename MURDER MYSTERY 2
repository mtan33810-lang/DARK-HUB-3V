getgenv().HBE = false

local HITBOX_SIZE = Vector3.new(15, 15, 15)
local HITBOX_COLOUR = Color3.fromRGB(255, 0, 0)

--========================================================
-- ROLE CHECK
--========================================================

local function GetLocalRole()
    local character = lp.Character
    if not character then
        return "Unknown"
    end

    local backpack = lp:FindFirstChildOfClass("Backpack")

    -- Knife = Murderer
    if character:FindFirstChild("Knife")
        or (backpack and backpack:FindFirstChild("Knife")) then

        return "Murderer"
    end

    -- Gun = Sheriff
    if character:FindFirstChild("Gun")
        or (backpack and backpack:FindFirstChild("Gun")) then

        return "Sheriff"
    end

    return "Innocent"
end

local function IsMurderer()
    return GetLocalRole() == "Murderer"
end

--========================================================
-- RESTORE HITBOX
--========================================================

local function RestoreHitbox(char)
    if not char then
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    root.Size = Vector3.new(2, 2, 1)
    root.Transparency = 1
    root.CanCollide = false
end

--========================================================
-- APPLY HITBOX
--========================================================

local function ApplyHitbox(char)
    if not char then
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    root.Size = HITBOX_SIZE
    root.Color = HITBOX_COLOUR
    root.CanCollide = false
    root.Transparency = 0.5
end

--========================================================
-- UPDATE ALL HITBOXES
--========================================================

local function UpdateHitboxes()
    -- Do absolutely nothing unless YOU are Murderer
    if not IsMurderer() then

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp then
                RestoreHitbox(player.Character)
            end
        end

        return
    end

    -- YOU ARE MURDERER
    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= lp then
            ApplyHitbox(player.Character)
        end

    end
end

--========================================================
-- HITBOX LOOP
--========================================================

local HitboxConnection

local function StartHitboxes()

    if HitboxConnection then
        HitboxConnection:Disconnect()
        HitboxConnection = nil
    end

    HitboxConnection = RunService.Heartbeat:Connect(function()

        if not getgenv().HBE then
            return
        end

        -- Sheriff / Innocent = restore hitboxes
        if not IsMurderer() then

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= lp then
                    RestoreHitbox(player.Character)
                end
            end

            return
        end

        -- Murderer = apply hitboxes
        for _, player in ipairs(Players:GetPlayers()) do

            if player ~= lp then
                ApplyHitbox(player.Character)
            end

        end

    end)

end

--========================================================
-- STOP HITBOXES
--========================================================

local function StopHitboxes()

    getgenv().HBE = false

    if HitboxConnection then
        HitboxConnection:Disconnect()
        HitboxConnection = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= lp then
            RestoreHitbox(player.Character)
        end

    end

end

