local CollisionDisabled = false
local OriginalCollision = {}

local function SetOtherPlayerCollision(player, disabled)
    if player == lp or not player.Character then
        return
    end

    for _, part in ipairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") then

            if disabled then
                if OriginalCollision[part] == nil then
                    OriginalCollision[part] = part.CanCollide
                end

                part.CanCollide = false

            else
                if OriginalCollision[part] ~= nil then
                    part.CanCollide = OriginalCollision[part]
                    OriginalCollision[part] = nil
                end
            end
        end
    end
end

local function UpdateAntiCollision()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp then
            SetOtherPlayerCollision(player, CollisionDisabled)
        end
    end
end

MainTab:CreateToggle({
    name = "Anti Fling ",
    description = "Disable collisions with other players",
    value = false,

    callback = function(value)
        CollisionDisabled = value

        if not value then
            -- Restore original collision
            UpdateAntiCollision()
        end
    end
})

RunService.Stepped:Connect(function()
    if CollisionDisabled then
        UpdateAntiCollision()
    end
end)

-- Handle players respawning
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if CollisionDisabled then
            task.wait(0.2)
            SetOtherPlayerCollision(player, true)
        end
    end)
end)

