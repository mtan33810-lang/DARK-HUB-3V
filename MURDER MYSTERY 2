--========================================================
-- STABLE AIM LOOP
--========================================================

pcall(function()
    RunService:UnbindFromRenderStep("DarkHub_Aimbot")
end)

RunService:BindToRenderStep(
    "DarkHub_Aimbot",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)

        -- FOV
        if Settings.ShowFOV then
            local viewport = Camera.ViewportSize

            FOVCircle.Position = Vector2.new(
                viewport.X * 0.5,
                viewport.Y * 0.5
            )

            FOVCircle.Radius = Settings.FOV
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end

        if not Settings.Aimbot then
            return
        end

        -- Acquire target
        local target = Settings.AimTarget

        if not IsValidTarget(target) then
            target = GetAimTarget()
            Settings.AimTarget = target
        end

        if not target or not target.Character then
            return
        end

        -- Selected aim part
        local targetPart =
            target.Character:FindFirstChild(Settings.TargetPart)
            or target.Character:FindFirstChild("HumanoidRootPart")

        if not targetPart or not targetPart.Parent then
            Settings.AimTarget = nil
            return
        end

        -- Smooth camera movement
        local targetCFrame = CFrame.lookAt(
            Camera.CFrame.Position,
            targetPart.Position
        )

        local lerpFactor = math.clamp(
            Settings.Smoothness * (deltaTime * 60),
            0.01,
            1
        )

        Camera.CFrame = Camera.CFrame:Lerp(
            targetCFrame,
            lerpFactor
        )
    end
)

