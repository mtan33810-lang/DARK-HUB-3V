-- APPLY HITBOX
--========================================================

local function ApplyHitbox(char)
    if not char then
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    root.Size = HITBOX_SIZE
    root.Color = HITBOX_COLOUR
    root.CanCollide = false
    root.Transparency = 0.5
end

--========================================================
-- UPDATE ALL HITBOXES
--========================================================

    local function UpdateHitboxes()
    if not getgenv().HBE then
        return
    end

    local myRole = GetLocalRole()

    --  YOU = MURDERER → EVERYONE gets hitbox
    if myRole == "Murderer" then

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp then
                ApplyHitbox(player.Character)
            end
        end

    --  SHERIFF → EVERYONE normal
    elseif myRole == "Sheriff" then

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp then
                RestoreHitbox(player.Character)
            end
        end

    --  INNOCENT → EVERYONE normal
    else

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp then
                RestoreHitbox(player.Character)
            end
        end
    end
end

