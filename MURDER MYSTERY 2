--// FUNCTIONS
--//========================================================

Environment.Functions = {}

function Environment.Functions:SetFling(state)
    Environment.Settings.FlingTouchToggle = state
end

function Environment.Functions:Exit()

    if Destroyed then
        return
    end

    Destroyed = true
    Environment.Settings.FlingTouchToggle = false

    for _, Connection in pairs(ServiceConnections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    table.clear(ServiceConnections)

    if getgenv().Fling then
        getgenv().Fling.Functions = nil
        getgenv().Fling = nil
    end
end

