--========================================================
-- AIM PREDICTION 
--========================================================

local function GetAutoPredictedPosition(targetPart, origin)
    if not targetPart or not origin then
        return nil
    end

    local targetPosition = targetPart.Position
    local velocity = targetPart.AssemblyLinearVelocity
    local distance = (targetPosition - origin).Magnitude

    local predictionTime = math.clamp(
        distance / 1000,
        0.03,
        0.20
    )

    return targetPosition + (velocity * predictionTime)
end

--========================================================
-- FIRE FUNCTION
--========================================================

local function FireAtAimTarget()

    local target = Settings.AimTarget

    if not target then
        return
    end

    local character = target.Character
    if not character then
        return
    end

    local targetPart =
        character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("HumanoidRootPart")

    if not targetPart then
        return
    end

    local myCharacter = lp.Character
    local root =
        myCharacter
        and myCharacter:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    -- Make the shot point from the player toward the target.
    local origin = root.Position

    local targetPosition = GetAutoPredictedPosition(
        targetPart,
        origin
    )

    if not targetPosition then
        return
    end

    local shotCFrame = CFrame.lookAt(
        origin,
        targetPosition
    )

    -- Your game's server-side gun handler should receive
    -- this request and validate the shot.
    local gun =
        lp.Character and lp.Character:FindFirstChild("Gun")
        or lp.Backpack and lp.Backpack:FindFirstChild("Gun")

    if not gun then
        return
    end

    local shootEvent = gun:FindFirstChild("Shoot")

    if not shootEvent then
        return
    end

    shootEvent:FireServer(
        shotCFrame,
        CFrame.new(targetPosition)
    )
end


