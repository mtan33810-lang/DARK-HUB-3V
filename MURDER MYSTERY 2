--========================================================
-- TARGET VALIDATION
--========================================================

local function IsTargetVisibleOnScreen(player)
    if not player or player == lp then
        return false
    end

    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    local targetPart =
        character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("HumanoidRootPart")

    if not targetPart then
        return false
    end

    local screenPosition, onScreen =
        Camera:WorldToViewportPoint(targetPart.Position)

    if not onScreen or screenPosition.Z <= 0 then
        return false
    end

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local screenDistance = (
        Vector2.new(
            screenPosition.X,
            screenPosition.Y
        ) - center
    ).Magnitude

    return screenDistance <= Settings.FOV
end

--========================================================
-- WALL CHECK
--========================================================

local function isVisible(targetPart)
    if not targetPart then
        return false
    end

    local character = targetPart:FindFirstAncestorOfClass("Model")

    if not character then
        return false
    end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    -- Only ignore your own character.
    -- DO NOT ignore the target character.
    wallCheckParams.FilterDescendantsInstances = {
        lp.Character
    }

    local result = Workspace:Raycast(
        origin,
        direction,
        wallCheckParams
    )

    if not result then
        return true
    end

    -- The first thing hit must belong to the target.
    return result.Instance:IsDescendantOf(character)
end


--========================================================
-- TARGET VALIDATION
--========================================================

local function IsValidTarget(player)
    if not player or player == lp then
        return false
    end

    -- Only enable targeting when YOU are the Sheriff
    if GetPlayerRole(lp) ~= "Sheriff" then
        return false
    end

    -- Only target the Murderer
    if GetPlayerRole(player) ~= "Murderer" then
        return false
    end

    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root then
        return false
    end

    local targetPart =
        character:FindFirstChild(Settings.TargetPart)
        or root

    if not targetPart then
        return false
    end

    if not IsTargetVisibleOnScreen(player) then
        return false
    end

    if not isVisible(targetPart) then
        return false
    end

    return true
end

--========================================================
-- GET AIM TARGET
--========================================================

local function GetAimTarget()
    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local closestPlayer = nil
    local closestDistance = Settings.FOV

    for _, player in Players:GetPlayers() do
        if player ~= lp and IsValidTarget(player) then
        
            local character = player.Character

            local targetPart =
                character:FindFirstChild(Settings.TargetPart)
                or character:FindFirstChild("HumanoidRootPart")

            if targetPart then
                local screenPosition =
                    Camera:WorldToViewportPoint(targetPart.Position)

                local distance = (
                    Vector2.new(
                        screenPosition.X,
                        screenPosition.Y
                    ) - center
                ).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end

    return closestPlayer
end

