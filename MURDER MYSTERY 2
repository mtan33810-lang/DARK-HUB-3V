--========================================================
-- GUN ESP + AUTO TELEPORT / SNAP BACK
--========================================================

local GunDropESP = false
local GunDropHighlight = nil
local GunTeleporting = false

local function GetGunDropPart(gunDrop)
    if not gunDrop then
        return nil
    end

    if gunDrop:IsA("BasePart") then
        return gunDrop
    end

    if gunDrop:IsA("Model") then
        return gunDrop.PrimaryPart
            or gunDrop:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function UpdateGunDropESP()
    if GunDropHighlight then
        GunDropHighlight:Destroy()
        GunDropHighlight = nil
    end

    if not GunDropESP then
        return
    end

    local gunDrop = Workspace:FindFirstChild("GunDrop", true)

    if not gunDrop then
        return
    end

    local gunPart = GetGunDropPart(gunDrop)

    if not gunPart then
        return
    end

    GunDropHighlight = Instance.new("Highlight")
    GunDropHighlight.Name = "GunDropESP"
    GunDropHighlight.Adornee = gunDrop
    GunDropHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    GunDropHighlight.FillColor = Color3.fromRGB(255, 220, 0)
    GunDropHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    GunDropHighlight.FillTransparency = 0.25
    GunDropHighlight.OutlineTransparency = 0
    GunDropHighlight.Parent = gunDrop
end

--========================================================
-- TELEPORT TO GUN -> SNAP BACK
--========================================================

local oldCFrame

local function TeleportToGunDrop()

    -- Only Innocents can teleport to the GunDrop
    if GetPlayerRole(lp) ~= "Innocent" then
        return
    end

    if not GunDropESP then
        return
    end

    if GunTeleporting then
        return
    end

    GunTeleporting = true

    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        GunTeleporting = false
        return
    end

    -- Save your starting position
    oldCFrame = root.CFrame

    local reachedGun = false

    while GunDropESP and not reachedGun do
        character = lp.Character
        root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            task.wait(0.1)
            continue
        end

        local gunDrop = Workspace:FindFirstChild("GunDrop", true)

        if not gunDrop then
            task.wait(0.1)
            continue
        end

        local gunPart = GetGunDropPart(gunDrop)

        if not gunPart then
            task.wait(0.1)
            continue
        end

        root.CFrame = gunPart.CFrame + Vector3.new(0, 3, 0)

        if (root.Position - gunPart.Position).Magnitude <= 5 then
            reachedGun = true
        end

        task.wait(0.05)
    end

    -- Stay at the gun briefly
    task.wait(0.01)

    -- Snap back to where you started
    if oldCFrame and root and root.Parent then
        root.CFrame = oldCFrame
    end

    GunTeleporting = false
end

