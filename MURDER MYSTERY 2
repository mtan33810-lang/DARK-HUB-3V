--========================================================
-- ROLE DETECTION
--========================================================

local function GetPlayerRole(plr)
    local backpack = plr:FindFirstChild("Backpack")
    local character = plr.Character

    if not backpack or not character then
        return "Unknown"
    end

    local knife =
        backpack:FindFirstChild("Knife")
        or character:FindFirstChild("Knife")

    local gun =
        backpack:FindFirstChild("Gun")
        or character:FindFirstChild("Gun")

    if knife then
        return "Murderer"
    elseif gun then
        return "Sheriff"
    else
        return "Innocent"
    end
end

local function GetRoleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 50, 50)

    elseif role == "Sheriff" then
        return Color3.fromRGB(50, 130, 255)

    elseif role == "Innocent" then
        return Color3.fromRGB(50, 255, 80)
    end

    return Color3.fromRGB(255, 255, 255)
end

--========================================================
-- SHERIFF DEATH TELEPORT
--========================================================

local SheriffDeathTeleport = false
local SheriffDeathBusy = false
local LastSheriff = nil

local function GetSheriff()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "Sheriff" then
            return player
        end
    end

    return nil
end

local function TeleportToSheriff()
    if SheriffDeathBusy or not SheriffDeathTeleport then
        return
    end

    local sheriff = GetSheriff()

    if not sheriff or not sheriff.Character then
        return
    end

    -- Find the Sheriff's actual Gun
    local gun =
        sheriff.Character:FindFirstChild("Gun")
        or sheriff.Backpack:FindFirstChild("Gun")

    if not gun then
        return
    end

    -- Find a physical part to teleport to
    local gunPart

    if gun:IsA("BasePart") then
        gunPart = gun
    elseif gun:IsA("Model") then
        gunPart =
            gun.PrimaryPart
            or gun:FindFirstChildWhichIsA("BasePart", true)
    end

    if not gunPart then
        return
    end

    local myCharacter = LocalPlayer.Character
    local myRoot =
        myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return
    end

    SheriffDeathBusy = true

    -- Save your position
    local oldCFrame = myRoot.CFrame

    -- Teleport directly to the gun
    myRoot.CFrame =
        gunPart.CFrame + Vector3.new(0, 3, 0)

    -- Let the teleport register
    task.wait(1.5)

    -- Snap back
    if myRoot and myRoot.Parent then
        myRoot.CFrame = oldCFrame
    end

    task.wait(0.1)

    SheriffDeathBusy = false
end

--========================================================
-- DETECT SHERIFF DEATH
--========================================================

local function WatchSheriff(player)

    if player == LocalPlayer then
        return
    end

    local function WatchCharacter(character)

        local humanoid =
            character:WaitForChild("Humanoid", 5)

        if not humanoid then
            return
        end

        humanoid.Died:Connect(function()

            if not SheriffDeathTeleport then
                return
            end

            if GetPlayerRole(player) ~= "Sheriff" then
                return
            end

            task.wait(0.05)

            TeleportToSheriff()
        end)
    end

    if player.Character then
        WatchCharacter(player.Character)
    end

    player.CharacterAdded:Connect(WatchCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do
    WatchSheriff(player)
end

Players.PlayerAdded:Connect(function(player)
    WatchSheriff(player)
end)

