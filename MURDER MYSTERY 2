--========================================================
-- GET MURDERER AIM TARGET
-- MOBILE FRIENDLY
--========================================================

local function GetAimTarget()
    Camera = Workspace.CurrentCamera

    if not Camera then
        return nil
    end

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local closestMurderer = nil
    local closestDistance = Settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= lp
            and GetPlayerRole(player) == "Murderer"
            and IsValidTarget(player)
        then

            local character = player.Character

            local targetPart =
                character:FindFirstChild(Settings.TargetPart)
                or character:FindFirstChild("HumanoidRootPart")

            if targetPart then

                local screenPosition, onScreen =
                    Camera:WorldToViewportPoint(
                        targetPart.Position
                    )

                if onScreen and screenPosition.Z > 0 then

                    local distance =
                        (
                            Vector2.new(
                                screenPosition.X,
                                screenPosition.Y
                            ) - center
                        ).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closestMurderer = player
                    end
                end
            end
        end
    end

    return closestMurderer
end

