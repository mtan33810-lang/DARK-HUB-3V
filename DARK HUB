--============================================================

task.spawn(function()
    while true do
        if AutoTrowelEnabled and TrowelRemote and PlacementCFrame then
            local Trowel = GetTrowel()
            local PlantsFolder = getPlantsPhysicalContainer()
            if Trowel and PlantsFolder then
                for _, plant in ipairs(PlantsFolder:GetChildren()) do
                    if not AutoTrowelEnabled then break end
                    if IsTargetPlant(plant) then
                        pcall(function() TrowelRemote:InvokeServer("Pickup", Trowel, plant) end)
                        task.wait(0.1)
                        pcall(function() TrowelRemote:InvokeServer("Place", Trowel, plant, PlacementCFrame) end)
                        task.wait(0.1)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

