local function convertSelection(Value)
    local selectedList = {}

    if type(Value) == "table" then
        for _, v in ipairs(Value) do
            local str = cleanItemName(v)
            if str ~= "No Seeds Found" and str ~= "None" and str ~= "" then
                table.insert(selectedList, str)
            end
        end
        return selectedList
    end

    if Value ~= nil then
        local str = cleanItemName(Value)
        if str ~= "No Seeds Found" and str ~= "None" and str ~= "" then
            return {str}
        end
    end

    return {}
end

local function containsIgnoreCase(text, search)
    if not text or not search then return false end
    local cleanTarget = cleanItemName(text)
    local cleanSearch = cleanItemName(search)
    return string.find(string.lower(cleanTarget), string.lower(cleanSearch), 1, true) ~= nil
end

local function selectionContains(list, value)
    if not list or #list == 0 then return false end
    for _, selected in ipairs(list) do
        if containsIgnoreCase(value, selected) then
            return true
        end
    end
    return false
end

local function getPlantPosition(Plant)
    if not Plant then return nil end
    if Plant:IsA("BasePart") then return Plant.Position end
    if Plant:IsA("Model") then
        if Plant.PrimaryPart then return Plant.PrimaryPart.Position end
        local Part = Plant:FindFirstChildWhichIsA("BasePart", true)
        if Part then return Part.Position end
    end
    return nil
end

