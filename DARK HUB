-- ============================================================
-- SEED FUNCTIONS
-- ============================================================

local function GetCleanSeedName(rawName)
    if type(rawName) ~= "string" then
        return ""
    end

    local name = rawName

    -- Remove [ID]
    name = name:gsub("%s*%b[]", "")

    -- Remove "Seed" from the end
    name = name:gsub("%s+[Ss][Ee][Ee][Dd]%s*$", "")

    -- Clean extra spaces
    name = name:gsub("%s+", " ")
    name = name:match("^%s*(.-)%s*$") or name

    return name
end

local function IsSeedTool(tool)
    if not tool:IsA("Tool") then
        return false
    end

    return tool.Name:lower():find("seed", 1, true) ~= nil
end

local function GetAvailableSeeds()
    local seeds = {}
    local found = {}

    local function Scan(container)
        if not container then
            return
        end

        for _, item in ipairs(container:GetChildren()) do
            if IsSeedTool(item) then
                local seedName = GetCleanSeedName(item.Name)

                if seedName ~= "" then
                    if SearchFilter == "" or
                        seedName:lower():find(SearchFilter:lower(), 1, true) then

                        if not found[seedName] then
                            found[seedName] = true
                            table.insert(seeds, seedName)
                        end
                    end
                end
            end
        end
    end

    Scan(LocalPlayer:FindFirstChild("Backpack"))
    Scan(LocalPlayer.Character)

    table.sort(seeds)

    if #seeds == 0 then
        return {"No Seeds Found"}
    end

    return seeds
end

local function HasSelectedSeed()
    if SelectedSeedName == "" then
        return false
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character

    local function Check(container)
        if not container then
            return false
        end

        for _, item in ipairs(container:GetChildren()) do
            if IsSeedTool(item) then
                if GetCleanSeedName(item.Name) == SelectedSeedName then
                    return true
                end
            end
        end

        return false
    end

    return Check(backpack) or Check(character)
end

-- ============================================================
-- RANDOM POSITION
-- ============================================================

local function GetRandomPlantPosition()
    local angle = math.random() * math.pi * 2

    -- Gives an even spread across the circle
    local distance = math.sqrt(math.random()) * RandomRadius

    local offsetX = math.cos(angle) * distance
    local offsetZ = math.sin(angle) * distance

    -- Uses the player's current position as the center
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local center = root.Position

    return center + Vector3.new(
        offsetX,
        0,
        offsetZ
    )
end

