--============================================================
-- NAME CLEANER HELPER
--============================================================

local function cleanItemName(name)
    if not name then return "" end
    local str = tostring(name)

    -- Strip quantities in brackets or parentheses like [x2882], [×2882], (x5), etc.
    str = string.gsub(str, "%s*%[%s*[x×X]%d+%s*%]", "")
    str = string.gsub(str, "%s*%(%s*[x×X]%d+%s*%)", "")
    str = string.gsub(str, "%s*%[%d+%]%", "")
    
    -- Strip 'Seed' / 'Seeds' suffix if present
    str = string.gsub(str, "%s*[S|s][E|e][E|e][D|d][S|s]?%s*", "")
    
    -- Trim whitespace
    str = string.gsub(str, "^%s*(.-)%s*$", "%1")
    return str
end

