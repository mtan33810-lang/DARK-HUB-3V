--============================================================
-- NPC VALIDATION
--============================================================

local function isValidEnemy(enemy)
    if not enemy or not enemy:IsA("Model") then return false end
    if not CollectionService:HasTag(enemy, "TestEnemy") then return false end

    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
    local root = enemy:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return false end
    return humanoid.Health > 0
end

--============================================================
-- PLAYER VALIDATION (FIXED FOR RIVALS)
--============================================================

local function isValidPlayerTarget(player)
    if not player or player == LocalPlayer then return false end

    local character = player.Character
    local localChar = LocalPlayer.Character
    if not character or not localChar then return false end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local targetPart = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not targetPart or humanoid.Health <= 0 then return false end

    if Settings.TeamCheck then
        -- 1. Standard Roblox Teams Check
        if player.Team ~= nil and LocalPlayer.Team ~= nil then
            if player.Team == LocalPlayer.Team then return false end
        end

        -- 2. Team Color Check (Ignores Neutral/White)
        if player.TeamColor == LocalPlayer.TeamColor and player.TeamColor ~= BrickColor.new("White") then
            return false
        end

        -- 3. Rivals Team Attributes (Checks both Player and Character models)
        local myTeam = LocalPlayer:GetAttribute("Team") 
            or localChar:GetAttribute("Team") 
            or LocalPlayer:GetAttribute("TeamColor")
            
        local enemyTeam = player:GetAttribute("Team") 
            or character:GetAttribute("Team") 
            or player:GetAttribute("TeamColor")

        if myTeam and enemyTeam and myTeam == enemyTeam then
            return false
        end

        -- 4. Rivals Model Highlights / Outlines (Red vs Blue/Green)
        local myHighlight = localChar:FindFirstChildOfClass("Highlight")
        local enemyHighlight = character:FindFirstChildOfClass("Highlight")
        if myHighlight and enemyHighlight then
            if myHighlight.FillColor == enemyHighlight.FillColor or myHighlight.OutlineColor == enemyHighlight.OutlineColor then
                return false
            end
        end

        -- 5. Workspace Folder Teams Check (e.g., workspace.Teams.Red)
        if character.Parent and localChar.Parent and character.Parent ~= workspace then
            if character.Parent == localChar.Parent then return false end
        end
    end

    return true
end

--============================================================
-- WALL CHECK
--============================================================

local function isVisible(targetPart)
    if not Settings.WallCheck then return true end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local ignore = {}
    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end
    wallCheckParams.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(origin, direction, wallCheckParams)
    return result == nil
end

--============================================================
-- NPC CLOSEST TARGET
--============================================================

local function getClosestEnemy()
    local character = getCharacter()
    local root = getRoot(character)
    if not root then return nil end

    local closest = nil
    local closestDistance = math.huge

    for _, enemy in ipairs(CollectionService:GetTagged("TestEnemy")) do
        if isValidEnemy(enemy) then
            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
            local distance = (root.Position - enemyRoot.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closest = enemy
            end
        end
    end

    return closest
end

--============================================================
-- PLAYER AIM TARGET
--============================================================

local function getAimTarget()
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local closest = nil
    local closestDistance = Settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayerTarget(player) then
            local character = player.Character
            local targetPart = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart")

            if targetPart and isVisible(targetPart) then
                local position, visible = Camera:WorldToViewportPoint(targetPart.Position)

                if visible and position.Z > 0 then
                    local distance = (Vector2.new(position.X, position.Y) - center).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    return closest
end

