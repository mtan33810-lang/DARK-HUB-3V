local autoCollectEnabled = false
local autoCollectAll = false
local autoCollectSelectedPlants = false
local selectedCollectPlants = {}

local collectionRadius = 500
local collectCooldown = 0.1

local function matchesPlant(Plant)
    if autoCollectAll then return true end
    if not autoCollectSelectedPlants then return false end
    local Name = getPlantName(Plant)
    return selectionContains(selectedCollectPlants, Name)
end

local function getCollectRemote()
    local Crops = GameEvents:FindFirstChild("Crops")
    if Crops then return Crops:FindFirstChild("Collect") end
    return GameEvents:FindFirstChild("Collect")
end

local function collectPlant(Plant)
    if not Plant then return end
    local CollectRemote = getCollectRemote()

    if CollectRemote then
        CollectRemote:FireServer({ Plant })
        return
    end

    local Prompt = Plant:FindFirstChildWhichIsA("ProximityPrompt", true)
    if Prompt and fireproximityprompt then
        fireproximityprompt(Prompt)
    end
end

local function getNearbyCollectPlants()
    local PlantsContainer = getPlantsPhysicalContainer()
    local RootPart = getRootPart()
    if not RootPart then return {} end

    local Result = {}
    local Seen = {}
    local searchList = PlantsContainer and PlantsContainer:GetDescendants() or Workspace:GetDescendants()

    for _, Object in ipairs(searchList) do
        local Plant = Object:IsA("Model") and Object or Object:FindFirstAncestorOfClass("Model")
        if Plant and not Seen[Plant] then
            Seen[Plant] = true
            if matchesPlant(Plant) then
                local Position = getPlantPosition(Plant)
                if Position then
                    local Distance = (RootPart.Position - Position).Magnitude
                    if Distance <= collectionRadius then
                        table.insert(Result, { Object = Plant, Distance = Distance })
                    end
                end
            end
        end
    end

    table.sort(Result, function(A, B) return A.Distance < B.Distance end)
    return Result
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if autoCollectEnabled then
            for _, Data in ipairs(getNearbyCollectPlants()) do
                if not autoCollectEnabled then break end
                collectPlant(Data.Object)
                task.wait(collectCooldown)
            end
        end
    end
end)

