--============================================================
-- TRAIT HELPERS
--============================================================

local function normalizeTrait(value)
    if value == nil then
        return ""
    end

    local text = tostring(value)
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return text
end

local function getPlantTraits(Plant)
    local Traits = {}

    if not Plant then
        return Traits
    end

    local Seen = {}

    local function addTrait(value)
        local Trait = normalizeTrait(value)

        if Trait ~= ""
            and not Seen[Trait]
            and Trait ~= "true"
            and Trait ~= "false" then

            Seen[Trait] = true
            table.insert(Traits, Trait)
        end
    end

    -- Scan attributes on the plant and its model
    for Name, Value in pairs(Plant:GetAttributes()) do
        local LowerName = string.lower(Name)

        -- Common trait-style attributes
        if LowerName:find("trait", 1, true)
            or LowerName:find("type", 1, true)
            or LowerName:find("category", 1, true) then

            if type(Value) == "string" then
                addTrait(Value)

            elseif type(Value) == "table" then
                for _, Trait in pairs(Value) do
                    addTrait(Trait)
                end
            end
        end
    end

    -- Also inspect descendant attributes, but only shallowly
    for _, Object in ipairs(Plant:GetChildren()) do
        for Name, Value in pairs(Object:GetAttributes()) do
            local LowerName = string.lower(Name)

            if LowerName:find("trait", 1, true)
                or LowerName:find("type", 1, true)
                or LowerName:find("category", 1, true) then

                if type(Value) == "string" then
                    addTrait(Value)
                end
            end
        end
    end

    table.sort(Traits)

    return Traits
end

local function plantHasSelectedTrait(Plant)
    if not selectedCollectTraits
        or #selectedCollectTraits == 0 then

        return false
    end

    local Traits = getPlantTraits(Plant)

    for _, PlantTrait in ipairs(Traits) do
        for _, SelectedTrait in ipairs(selectedCollectTraits) do

            if string.lower(PlantTrait)
                == string.lower(SelectedTrait) then

                return true
            end
        end
    end

    return false
end

--============================================================
-- PLANT MATCHING
--============================================================

local function matchesPlant(Plant)

    if autoCollectAll then
        return true
    end

    -- Individual plant selection
    if autoCollectSelectedPlants then
        local Name = getPlantName(Plant)

        if selectionContains(selectedCollectPlants, Name) then
            return true
        end
    end

    -- Trait selection
    if autoCollectSelectedTraits then
        if plantHasSelectedTrait(Plant) then
            return true
        end
    end

    return false
end

