local function isWaterCanEquipped()
    local Character = getCharacter()
    if not Character then return false end

    for _, Tool in ipairs(Character:GetChildren()) do
        if Tool:IsA("Tool") and (string.lower(Tool.Name) == string.lower(selectedWaterCan) or containsIgnoreCase(Tool.Name, "water")) then
            return true
        end
    end
    return false
end

local function equipWaterCan()
    local Character = getCharacter()
    local Humanoid = getHumanoid()
    if not Character or not Humanoid then return false end

    if isWaterCanEquipped() then return true end

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not Backpack then return false end

    for _, Tool in ipairs(Backpack:GetChildren()) do
        if Tool:IsA("Tool") and (string.lower(Tool.Name) == string.lower(selectedWaterCan) or containsIgnoreCase(Tool.Name, "water")) then
            Humanoid:EquipTool(Tool)
            return true
        end
    end
    return false
end

local function waterPlant(Plant)
    local Remote = getWaterRemote()
    if not Remote then return end
    local Position = getPlantPosition(Plant)
    if Position then
        Remote:FireServer(Position)
    end
end

local function getNearbyWaterPlants()
    local PlantsContainer = getPlantsPhysicalContainer()
    local RootPart = getRootPart()
    if not RootPart then return {} end

    local Result = {}
    local rawList = PlantsContainer and PlantsContainer:GetChildren() or Workspace:GetChildren()

    for _, Plant in ipairs(rawList) do
        local Position = getPlantPosition(Plant)
        if Position then
            local Distance = (RootPart.Position - Position).Magnitude
            if Distance <= waterRadius then
                local Name = getPlantName(Plant)
                local Allowed = #selectedWaterPlants == 0 or selectionContains(selectedWaterPlants, Name)
                if Allowed then
                    table.insert(Result, { Object = Plant, Distance = Distance })
                end
            end
        end
    end

    table.sort(Result, function(A, B) return A.Distance < B.Distance end)
    return Result
end

