local function scanAvailableTraits()

    local Traits = {}
    local Seen = {}

    local PlantsContainer = getPlantsPhysicalContainer()

    if not PlantsContainer then
        return {"No Traits Found"}
    end

    -- IMPORTANT:
    -- Only inspect Models directly to avoid an enormous
    -- GetDescendants() result and UI freezing.

    for _, Plant in ipairs(PlantsContainer:GetChildren()) do

        if Plant:IsA("Model") then

            local PlantTraits = getPlantTraits(Plant)

            for _, Trait in ipairs(PlantTraits) do

                if not Seen[Trait] then

                    Seen[Trait] = true
                    table.insert(Traits, Trait)

                end
            end
        end
    end

    table.sort(Traits)

    if #Traits == 0 then
        return {"No Traits Found"}
    end

    return Traits
end

