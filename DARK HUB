--============================================================
-- ENHANCED TEAM & TARGET VALIDATION
--============================================================

local function isValidPlayerTarget(player)
    if not player or player == LocalPlayer then return false end

    local localChar = LocalPlayer.Character
    local targetChar = player.Character
    if not localChar or not targetChar then return false end

    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    local targetPart = targetChar:FindFirstChild(Settings.TargetPart) or targetChar:FindFirstChild("HumanoidRootPart")

    if not humanoid or not targetPart or humanoid.Health <= 0 then return false end

    if Settings.TeamCheck then
        -- 1. Standard Roblox Team Check
        if player.Team ~= nil and LocalPlayer.Team ~= nil then
            if player.Team == LocalPlayer.Team then return false end
        end

        -- 2. Team Color / BrickColor Check
        if player.TeamColor == LocalPlayer.TeamColor and player.TeamColor ~= BrickColor.new("White") then
            return false
        end

        -- 3. Custom Attributes (Common in modern Roblox FPS titles)
        local myTeamAttr = LocalPlayer:GetAttribute("Team") or localChar:GetAttribute("Team") or LocalPlayer:GetAttribute("TeamColor") or localChar:GetAttribute("Squad")
        local enemyTeamAttr = player:GetAttribute("Team") or targetChar:GetAttribute("Team") or player:GetAttribute("TeamColor") or targetChar:GetAttribute("Squad")

        if myTeamAttr ~= nil and enemyTeamAttr ~= nil and myTeamAttr == enemyTeamAttr then
            return false
        end

        -- 4. Parent Hierarchy Check (Teammate models grouped under specific Workspace Folders)
        if targetChar.Parent and localChar.Parent then
            if targetChar.Parent ~= Workspace and targetChar.Parent == localChar.Parent then
                return false
            end
        end

        -- 5. Highlight & Marker Colors (Engine visual team identifiers)
        local myHighlight = localChar:FindFirstChildOfClass("Highlight")
        local enemyHighlight = targetChar:FindFirstChildOfClass("Highlight")
        if myHighlight and enemyHighlight then
            if myHighlight.FillColor == enemyHighlight.FillColor or myHighlight.OutlineColor == enemyHighlight.OutlineColor then
                return false
            end
        end
    end

    return true
end

--============================================================
-- FAST WALL CHECK
--============================================================

local function isVisible(targetPart)
    if not Settings.WallCheck then return true end

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local ignore = {LocalPlayer.Character}
    wallCheckParams.FilterDescendantsInstances = ignore

    return Workspace:Raycast(origin, direction, wallCheckParams) == nil
end

--============================================================
-- STABLE AIM TARGET SELECTOR
--============================================================

local function getAimTarget()
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)

    local closest = nil
    local closestDistance = Settings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayerTarget(player) then
            local character = player.Character
            local targetPart = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart")

            if targetPart and isVisible(targetPart) then
                local position, visible = Camera:WorldToViewportPoint(targetPart.Position)

                -- Ensure target is strictly in front of camera
                if visible and position.Z > 0 then
                    local distance = (Vector2.new(position.X, position.Y) - center).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end

    return closest
end

