end

-- ============================================================
-- RANDOM PLANT ONCE
-- ============================================================

local function RandomPlantOnce()
    if SelectedSeedName == "" then
        Rayfield:Notify({
            Title = "Auto Planter",
            Content = "Select a seed first.",
            Duration = 3
        })
        return
    end

    if not HasSelectedSeed() then
        Rayfield:Notify({
            Title = "Auto Planter",
            Content = "Selected seed is not in your inventory.",
            Duration = 3
        })
        return
    end

    for i = 1, RandomCount do
        local position = GetRandomPlantPosition()

        if position then
            PlantAt(position)
        end

        task.wait(PlantDelay)
    end

    Rayfield:Notify({
        Title = "Auto Planter",
        Content = "Finished planting " .. RandomCount .. " random plants.",
        Duration = 3
    })
end

-- ============================================================
-- INFINITE RANDOM PLANT
-- ============================================================

local function StartInfinitePlant()
    if PlantLoopRunning then
        return
    end

    PlantLoopRunning = true

    task.spawn(function()
        while InfinitePlant do

            if SelectedSeedName == "" then
                task.wait(0.5)
                continue
            end

            if not HasSelectedSeed() then
                task.wait(1)
                continue
            end

            for i = 1, RandomCount do
                if not InfinitePlant then
                    break
                end

                local position = GetRandomPlantPosition()

                if position then
                    PlantAt(position)
                end

                task.wait(PlantDelay)
            end

            task.wait(0.1)
        end

        PlantLoopRunning = false
    end)
end

