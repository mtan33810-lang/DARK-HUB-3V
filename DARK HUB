local function getBackpackSeedsList()
    local Result = {}
    local Seen = {}

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local Character = getCharacter()

    local function isSeed(item)
        local rawName = item.Name
        local lower = string.lower(rawName)

        -- Must explicitly contain "seed" in the name or have a seed-related attribute
        local hasSeedName = string.find(lower, "seed") ~= nil
        local hasSeedAttr = item:GetAttribute("IsSeed") == true or item:GetAttribute("SeedName") ~= nil

        return hasSeedName or hasSeedAttr
    end

    local function scanContainer(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and isSeed(item) then
                local baseName = item:GetAttribute("SeedName") or item.Name
                local cleanedName = cleanItemName(baseName)

                if cleanedName ~= "" and cleanedName ~= "No Seeds Found" and not Seen[cleanedName] then
                    Seen[cleanedName] = true
                    table.insert(Result, cleanedName)
                end
            end
        end
    end

    scanContainer(Backpack)
    scanContainer(Character)

    table.sort(Result)

    if #Result == 0 then
        return {"No Seeds Found"}
    end

    return Result
end

local function filterList(sourceList, searchText)
    local filtered = {}
    local search = string.lower(searchText or "")
    if search == "" then return sourceList end

    for _, item in ipairs(sourceList) do
        if string.find(string.lower(item), search, 1, true) then
            table.insert(filtered, item)
        end
    end
    
    if #filtered == 0 then return {"No Seeds Found"} end
    return filtered
end

