local function getPlantsPhysicalContainer()
    local Farm = Workspace:FindFirstChild("Farm")
    if Farm then
        local NestedFarm = Farm:FindFirstChild("Farm")
        if NestedFarm then
            local Important = NestedFarm:FindFirstChild("Important")
            if Important then
                local Plants = Important:FindFirstChild("Plants_Physical") or Important:FindFirstChild("Plants")
                if Plants then return Plants end
            end
        end
        local DirectPlants = Farm:FindFirstChild("Plants_Physical", true) or Farm:FindFirstChild("Plants", true)
        if DirectPlants then return DirectPlants end
    end

    local FarmsFolder = Workspace:FindFirstChild("Farms") or Workspace:FindFirstChild("Plots")
    if FarmsFolder then
        local MyPlot = FarmsFolder:FindFirstChild(LocalPlayer.Name) or FarmsFolder:FindFirstChild(LocalPlayer.DisplayName)
        if MyPlot then
            local Plants = MyPlot:FindFirstChild("Plants_Physical", true) or MyPlot:FindFirstChild("Plants", true)
            if Plants then return Plants end
        end
    end

    return Workspace:FindFirstChild("Plants_Physical", true) or Workspace:FindFirstChild("Plants", true)
end

local function getPlantName(Plant)
    if not Plant then return "" end

    local AttributeName = Plant:GetAttribute("PlantName") or Plant:GetAttribute("Species") or Plant:GetAttribute("Type")
    local rawName = AttributeName and tostring(AttributeName) or Plant.Name

    if rawName == "Part" or rawName == "Model" or rawName == "Base" or rawName == "Dirt" or rawName == "Plot" then
        return ""
    end

    return cleanItemName(rawName)
end

