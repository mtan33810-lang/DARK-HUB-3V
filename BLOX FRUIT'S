local State = {
    combo = 0,

    autoPlayer = false,
    autoMob = false,
    killAura = false,
    autoSkills = false,
    follow = false,
    bounty = false,
    noStun = false,

    oldCameraSubject = nil,
}

local Connections = {}
local Threads = {}

--//========================================================
--// CONNECTION / THREAD MANAGEMENT
--//========================================================

local function connect(connection)
    table.insert(Connections, connection)
    return connection
end

local function spawnThread(callback)
    local thread = task.spawn(callback)
    table.insert(Threads, thread)
    return thread
end

local function stopThread(thread)
    if thread then
        pcall(task.cancel, thread)
    end
end

--//========================================================
--// CHARACTER HELPERS
--//========================================================

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getMyRoot()
    return getRoot(getCharacter())
end

local function getMyHumanoid()
    return getHumanoid(getCharacter())
end

local function alive(character)
    local humanoid = getHumanoid(character)
    return humanoid and humanoid.Health > 0
end

--//========================================================
--// NETWORK
--//========================================================

local function getNetwork()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")

    if not net then
        return nil, nil
    end

    return
        net:FindFirstChild("RE/RegisterAttack"),
        net:FindFirstChild("RE/RegisterHit")
end

--//========================================================
--// ATTACK HELPERS
--//========================================================

local function attackDelay()
    if Config.fastAttack then
        return 0.08
    end

    return Config.attackDelay
end

local function getTargetPart(character)
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
        or character:FindFirstChildWhichIsA("BasePart")
end

local function isFishingRod(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    local tooltip = tostring(tool.ToolTip or "")

    return
        tooltip:find("Fishing") ~= nil
        or tooltip:find("Rod") ~= nil
        or tool.Name:find("Rod") ~= nil
end

local function isRaidChip(tool)
    return tool
        and tool:IsA("Tool")
        and tool.Name:find("Microchip") ~= nil
end

local function unequipBadTool()
    local character = getCharacter()

    if not character then
        return
    end

    local equipped = character:FindFirstChildOfClass("Tool")

    if not equipped then
        return
    end

    if isFishingRod(equipped) or isRaidChip(equipped) then
        local humanoid = getHumanoid(character)

        if humanoid then
            pcall(function()
                humanoid:UnequipTools()
            end)
        end
    end
end

local function equipWeapon()
    local character = getCharacter()
    local humanoid = getHumanoid(character)

    if not humanoid then
        return
    end

    local equipped = character:FindFirstChildOfClass("Tool")

    if equipped
        and not isFishingRod(equipped)
        and not isRaidChip(equipped)
    then
        return
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if not backpack then
        return
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool")
            and not isFishingRod(tool)
            and not isRaidChip(tool)
        then
            pcall(function()
                humanoid:EquipTool(tool)
            end)

            break
        end
    end
end

--//========================================================
--// LINE OF SIGHT
--//========================================================

local function hasLineOfSight(targetPart, targetModel)
    local root = getMyRoot()

    if not root or not targetPart then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignore = {
        getCharacter(),
        targetModel,
    }

    params.FilterDescendantsInstances = ignore

    local direction = targetPart.Position - root.Position

    local result = workspace:Raycast(
        root.Position,
        direction,
        params
    )

    return result == nil
end

--//========================================================
--// MOB SEARCH
--//========================================================

local function getNearestMob(range)
    local root = getMyRoot()
    local enemies = workspace:FindFirstChild("Enemies")

    if not root or not enemies then
        return nil
    end

    local closest
    local closestDistance

    for _, enemy in ipairs(enemies:GetChildren()) do
        local humanoid = getHumanoid(enemy)
        local part = getTargetPart(enemy)

        if humanoid
            and humanoid.Health > 0
            and part
        then
            local distance =
                (part.Position - root.Position).Magnitude

            if distance <= range then
                if not closestDistance
                    or distance < closestDistance
                then
                    closest = enemy
                    closestDistance = distance
                end
            end
        end
    end

    return closest
end

--//========================================================
--// PLAYER SEARCH
--//========================================================

local function getNearestPlayer(range)
    local root = getMyRoot()

    if not root then
        return nil
    end

    local closest
    local closestDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local targetRoot = getRoot(character)
            local humanoid = getHumanoid(character)

            if targetRoot
                and humanoid
                and humanoid.Health > 0
            then
                local distance =
                    (targetRoot.Position - root.Position).Magnitude

                if (not range or distance <= range) then
                    if not closestDistance
                        or distance < closestDistance
                    then
                        closest = character
                        closestDistance = distance
                    end
                end
            end
        end
    end

    return closest
end

local function getPlayersInRange(range)
    local root = getMyRoot()
    local result = {}

    if not root then
        return result
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local targetRoot = getRoot(character)
            local humanoid = getHumanoid(character)

            if targetRoot
                and humanoid
                and humanoid.Health > 0
            then
                if
                    (targetRoot.Position - root.Position).Magnitude
                    <= range
                then
                    table.insert(result, character)
                end
            end
        end
    end

    return result
end

--//========================================================
--// ATTACK
--//========================================================

local function attackTarget(target)
    if not target or not alive(target) then
        return
    end

    unequipBadTool()

    local RegisterAttack, RegisterHit = getNetwork()

    if not RegisterAttack or not RegisterHit then
        return
    end

    local part = getTargetPart(target)

    if not part then
        return
    end

    State.combo = (State.combo % 4) + 1

    pcall(function()
        RegisterAttack:FireServer(
            0.4,
            State.combo
        )

        RegisterHit:FireServer(
            part,
            {},
            nil
        )
    end)
end

local function attackTargets(targets)
    if #targets == 0 then
        return
    end

    for _, target in ipairs(targets) do
        if target and alive(target) then
            attackTarget(target)
        end
    end
end

--//========================================================
--// AUTO PLAYER ATTACK
--//========================================================

local function startPlayerAttack()
    if State.autoPlayer then
        return
    end

    State.autoPlayer = true

    spawnThread(function()
        while State.autoPlayer do
            local targets =
                getPlayersInRange(Config.playerRange)

            attackTargets(targets)

            task.wait(attackDelay())
        end
    end)
end

local function stopPlayerAttack()
    State.autoPlayer = false
end

--//========================================================
--// AUTO MOB ATTACK
--//========================================================

local function startMobAttack()
    if State.autoMob then
        return
    end

    State.autoMob = true

    spawnThread(function()
        while State.autoMob do
            local target =
                getNearestMob(Config.mobRange)

            if target then
                attackTarget(target)
            end

            task.wait(attackDelay())
        end
    end)
end

local function stopMobAttack()
    State.autoMob = false
end

--//========================================================
--// KILL AURA
--//========================================================

local function startKillAura()
    if State.killAura then
        return
    end

    State.killAura = true

    spawnThread(function()
        while State.killAura do
            local root = getMyRoot()

            if root then
                local enemies =
                    workspace:FindFirstChild("Enemies")

                if enemies then
                    for _, enemy in ipairs(enemies:GetChildren()) do
                        local humanoid = getHumanoid(enemy)
                        local part = getTargetPart(enemy)

                        if humanoid
                            and humanoid.Health > 0
                            and part
                        then
                            local distance =
                                (part.Position - root.Position).Magnitude

                            if distance <= Config.auraRange then
                                if not Config.lineOfSight
                                    or hasLineOfSight(part, enemy)
                                then
                                    attackTarget(enemy)
                                end
                            end
                        end
                    end
                end

                if Config.targetPlayers then
                    for _, character in ipairs(
                        getPlayersInRange(Config.auraRange)
                    ) do
                        local part = getTargetPart(character)

                        if part then
                            if not Config.lineOfSight
                                or hasLineOfSight(part, character)
                            then
                                attackTarget(character)
                            end
                        end
                    end
                end
            end

            task.wait(attackDelay())
        end
    end)
end

local function stopKillAura()
    State.killAura = false
end

