--========================================================

local function isKind(tool, kind)

    if not tool:IsA("Tool") then
        return false
    end

    if kind == "Fruit" then
        return tool.ToolTip == "Blox Fruit"
    end

    return tool.ToolTip == kind
end

function M.equipWeapon(kind)

    local char = LP.Character
    local hum = humanoid()

    if not char or not hum then
        return
    end

    local equipped = char:FindFirstChildOfClass("Tool")

    if equipped and isKind(equipped, kind) then
        return
    end

    local backpack = LP:FindFirstChild("Backpack")

    for _, container in ipairs({char, backpack}) do

        if container then

            for _, tool in ipairs(container:GetChildren()) do

                if isKind(tool, kind) then
                    pcall(function()
                        hum:EquipTool(tool)
                    end)

                    return
                end
            end
        end
    end
end

--========================================================
-- TELEPORT
--========================================================

local TweenService = game:GetService("TweenService")

local Teleport = {}

Teleport.config = {
    speed = 100, -- studs per second
}

local currentTween

function Teleport.go(position)

    if typeof(position) ~= "Vector3" then
        return false
    end

    local root = hrp()

    if not root then
        return false
    end

    -- Cancel previous teleport
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end

    local distance =
        (root.Position - position).Magnitude

    if distance < 3 then
        root.CFrame = CFrame.new(position)
        return true
    end

    local duration =
        math.max(
            distance / Teleport.config.speed,
            0.05
        )

    currentTween = TweenService:Create(
        root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = CFrame.new(position)
        }
    )

    currentTween:Play()

    currentTween.Completed:Connect(function()
        if currentTween then
            currentTween = nil
        end
    end)

    return true
end

function Teleport.cancel()

    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

