--========================================================
-- BRING / FOLLOW UPDATE
--========================================================

RunService.RenderStepped:Connect(function()

    if not (
        M._farmOn
        or M._bossOn
        or M._nearestOn
    ) then
        return
    end

    local root = hrp()

    if not root then
        return
    end

    if M.config.bring and M._anchor then

        root.CFrame =
            CFrame.new(
                M._anchor
                + Vector3.new(
                    0,
                    M.config.heightOffset,
                    0
                )
            )

        root.AssemblyLinearVelocity =
            Vector3.zero

        if M._mobName then

            local folder =
                workspace:FindFirstChild("Enemies")

            if folder then

                for _, enemy in ipairs(folder:GetChildren()) do

                    if enemy.Name:lower()
                        == M._mobName:lower()
                    then

                        local hum =
                            enemy:FindFirstChildOfClass(
                                "Humanoid"
                            )

                        local part =
                            enemy:FindFirstChild(
                                "HumanoidRootPart"
                            )
                            or enemy.PrimaryPart

                        if hum and
                            hum.Health > 0 and
                            part
                        then

                            if not M._decollided[enemy] then

                                for _, obj in ipairs(
                                    enemy:GetDescendants()
                                ) do

                                    if obj:IsA("BasePart") then
                                        obj.CanCollide = false
                                    end

                                end

                                M._decollided[enemy] = true
                            end

                            part.CFrame =
                                CFrame.new(
                                    M._anchor
                                )

                            part.AssemblyLinearVelocity =
                                Vector3.zero
                        end
                    end
                end
            end
        end

    else

        local target =
            M._target

        local part =
            target
            and (
                target:FindFirstChild(
                    "HumanoidRootPart"
                )
                or target.PrimaryPart
            )

        if part then

            local distance =
                (part.Position - root.Position).Magnitude

            if distance <
                M.config.hoverRange
            then

                root.CFrame =
                    CFrame.new(
                        part.Position
                        + Vector3.new(
                            0,
                            M.config.heightOffset,
                            0
                        )
                    )

                root.AssemblyLinearVelocity =
                    Vector3.zero
            end
        end
    end
end)

