--========================================================
-- QUEST HELPERS
--========================================================

function M.currentList()
    local level = M.playerLevel()

    if level >= 1500 then
        return M.sea3
    elseif level >= 700 then
        return M.sea2
    end

    return M.sea1
end

function M.bestForLevel()
    local list = M.currentList()
    local level = M.playerLevel()
    local best = list[1]

    for _, q in ipairs(list) do
        if q.level <= level then
            best = q
        else
            break
        end
    end

    return best
end

--========================================================
-- ENEMIES
--========================================================

function M.aliveMobs(name)
    local folder = workspace:FindFirstChild("Enemies")
    local result = {}

    if not folder then
        return result
    end

    for _, enemy in ipairs(folder:GetChildren()) do
        if enemy.Name:lower() == name:lower() then
            local hum = enemy:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 then
                result[#result + 1] = enemy
            end
        end
    end

    return result
end

function M.nearestMob(name)
    local root = hrp()
    local folder = workspace:FindFirstChild("Enemies")

    if not root or not folder then
        return nil
    end

    local best
    local bestDistance

    for _, enemy in ipairs(folder:GetChildren()) do
        if enemy.Name:lower() == name:lower() then

            local hum = enemy:FindFirstChildOfClass("Humanoid")
            local part =
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy.PrimaryPart

            if hum and hum.Health > 0 and part then
                local distance =
                    (part.Position - root.Position).Magnitude

                if not bestDistance or distance < bestDistance then
                    best = enemy
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

function M.nearestAnyMob()
    local root = hrp()
    local folder = workspace:FindFirstChild("Enemies")

    if not root or not folder then
        return nil
    end

    local best
    local bestDistance

    for _, enemy in ipairs(folder:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        local part =
            enemy:FindFirstChild("HumanoidRootPart")
            or enemy.PrimaryPart

        if hum and hum.Health > 0 and part then
            local distance =
                (part.Position - root.Position).Magnitude

            if not bestDistance or distance < bestDistance then
                best = enemy
                bestDistance = distance
            end
        end
    end

    return best
end

