local function getRemotes()

    return ReplicatedStorage:
        FindFirstChild("Remotes")

end

function PlayerModule.setKen(enabled)

    PlayerModule.config.ken = enabled

    local remotes =
        getRemotes()

    if not remotes then
        return
    end

    local CommE =
        remotes:FindFirstChild("CommE")

    if CommE then

        pcall(function()

            CommE:FireServer(
                "Ken",
                enabled
            )

        end)

    end
end

function PlayerModule.setBuso(enabled)

    PlayerModule.config.buso = enabled

    local remotes =
        getRemotes()

    if not remotes then
        return
    end

    local CommF =
        remotes:FindFirstChild("CommF_")

    if CommF then

        pcall(function()

            CommF:InvokeServer("Buso")

        end)

    end
end

