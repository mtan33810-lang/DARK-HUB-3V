local PlayerModule = {}

PlayerModule.config = {
    noclip = false,
    walkWater = false,

    speedOn = false,
    walkSpeed = 50,

    jumpOn = false,
    jumpPower = 120,

    walkWater = false,

    ken = false,
    buso = false,

    antiAfk = true,
}

PlayerModule._esp = {}
PlayerModule._espOn = false
PlayerModule._platform = nil
PlayerModule._connections = {}

--========================================================
-- HELPERS
--========================================================

local function getCharacter()
    return LP.Character
end

local function getRoot()
    local character = getCharacter()

    return character
        and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = getCharacter()

    return character
        and character:FindFirstChildOfClass("Humanoid")
end

--========================================================
-- PLAYER ESP
--========================================================

local function createESP(player)

    if player == LP then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    if PlayerModule._esp[player] then
        return
    end

    local highlight = Instance.new("Highlight")

    highlight.Name = "DarkHub_PlayerESP"
    highlight.FillColor =
        Color3.fromRGB(255, 80, 80)

    highlight.OutlineColor =
        Color3.fromRGB(255, 255, 255)

    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0

    highlight.Adornee = character
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")

    billboard.Name = "DarkHub_Distance"
    billboard.Size =
        UDim2.fromOffset(120, 30)

    billboard.StudsOffset =
        Vector3.new(0, 3, 0)

    billboard.AlwaysOnTop = true
    billboard.Adornee =
        character:FindFirstChild("HumanoidRootPart")
        or character

    billboard.Parent = character

    local label = Instance.new("TextLabel")

    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)

    label.Font = Enum.Font.Gotham
    label.TextSize = 11

    label.TextColor3 =
        Color3.new(1, 1, 1)

    label.TextStrokeTransparency = 0.5
    label.Text = player.Name

    label.Parent = billboard

    PlayerModule._esp[player] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        character = character,
    }
end

local function removeESP(player)

    local esp =
        PlayerModule._esp[player]

    if not esp then
        return
    end

    pcall(function()
        esp.highlight:Destroy()
        esp.billboard:Destroy()
    end)

    PlayerModule._esp[player] = nil
end

local function clearESP()

    for player in pairs(
        PlayerModule._esp
    ) do

        removeESP(player)

    end
end

local function setESP(enabled)

    PlayerModule._espOn = enabled

    if not enabled then
        clearESP()
        return
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LP then
            createESP(player)
        end

    end
end

--========================================================
-- ESP LOOP
--========================================================

table.insert(
    PlayerModule._connections,

    RunService.Heartbeat:Connect(function()

        if not PlayerModule._espOn then
            return
        end

        local myRoot = getRoot()

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if player ~= LP then

                local character =
                    player.Character

                if character then

                    local esp =
                        PlayerModule._esp[player]

                    if not esp
                        or esp.character ~= character
                    then

                        removeESP(player)
                        createESP(player)

                        esp =
                            PlayerModule._esp[player]
                    end

                    if esp then

                        local targetRoot =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if targetRoot
                            and myRoot
                        then

                            local distance =
                                math.floor(
                                    (
                                        targetRoot.Position
                                        - myRoot.Position
                                    ).Magnitude
                                )

                            esp.label.Text =
                                player.Name
                                .. "\n"
                                .. distance
                                .. "m"

                        end
                    end
                end
            end
        end

        for player in pairs(
            PlayerModule._esp
        ) do

            if not Players:FindFirstChild(
                player.Name
            ) then

                removeESP(player)

            end
        end
    end)
)

--========================================================
-- NOCLIP
--========================================================

table.insert(
    PlayerModule._connections,

    RunService.Stepped:Connect(function()

        if not PlayerModule.config.noclip then
            return
        end

        local character =
            getCharacter()

        if not character then
            return
        end

        for _, part in ipairs(
            character:GetDescendants()
        ) do

            if part:IsA("BasePart") then
                part.CanCollide = false
            end

        end
    end)
)

--========================================================
-- WALK ON WATER
--========================================================

table.insert(
    PlayerModule._connections,

    RunService.Heartbeat:Connect(function()

        if not PlayerModule.config.walkWater then

            if PlayerModule._platform then
                PlayerModule._platform:Destroy()
                PlayerModule._platform = nil
            end

            return
        end

        local character = LP.Character
        local root = getRoot()
        local humanoid = getHumanoid()

        if not character or not root or not humanoid then
            return
        end

        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.Swimming then

            if not PlayerModule._platform then

                local platform = Instance.new("Part")

                platform.Name =
                    "DarkHub_WaterPlatform"

                platform.Size =
                    Vector3.new(30, 1, 30)

                platform.Anchored = true
                platform.CanCollide = true
                platform.Transparency = 1

                platform.Parent = workspace

                PlayerModule._platform =
                    platform

                PlayerModule._waterY =
                    root.Position.Y - 3
            end

            local platform =
                PlayerModule._platform

            platform.Position =
                Vector3.new(
                    root.Position.X,
                    PlayerModule._waterY,
                    root.Position.Z
                )

            if root.Position.Y <
                PlayerModule._waterY + 2
            then

                root.CFrame =
                    CFrame.new(
                        root.Position.X,
                        PlayerModule._waterY + 3,
                        root.Position.Z
                    )
            end

        elseif PlayerModule._platform then

            PlayerModule._platform:Destroy()
            PlayerModule._platform = nil

        end
    end)
)

--========================================================
-- SPEED / JUMP
--========================================================

table.insert(
    PlayerModule._connections,

    RunService.RenderStepped:Connect(function()

        local humanoid =
            getHumanoid()

        if not humanoid then
            return
        end

        if PlayerModule.config.speedOn then

            humanoid.WalkSpeed =
                PlayerModule.config.walkSpeed

        end

        if PlayerModule.config.jumpOn then

            humanoid.UseJumpPower = true

            humanoid.JumpPower =
                PlayerModule.config.jumpPower

        end
    end)
)

