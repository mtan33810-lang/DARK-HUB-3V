--========================================================
-- FARM STEP
--========================================================

function M._farmStep()

    local quest =
        M.selected
        or M.bestForLevel()

    if not quest then
        task.wait(1)
        return
    end

    M._mobName = quest.mob

    local key =
        quest.id .. "#" .. tostring(quest.tier)

    -- New quest target
    if key ~= M._curKey then

        M._curKey = key
        M._target = nil
        M._anchor = nil

        M._killCount = 0
        M._killReq =
            quest.kills
            or M.kills[quest.mob]
            or 8

        M._prevAlive = nil

        M.startQuest()
    end

    -- Restart quest when required kills reached.
    if M._killCount >= M._killReq then

        M._killCount = 0
        M._prevAlive = nil

        M.startQuest()

        task.wait(0.2)
    end

    local mobs =
        M.aliveMobs(quest.mob)

    local currentAlive = {}

    for _, enemy in ipairs(mobs) do
        currentAlive[enemy] = true
    end

    if M._prevAlive then

        for enemy in pairs(M._prevAlive) do

            if not currentAlive[enemy] then
                M._killCount += 1
            end

        end
    end

    M._prevAlive = currentAlive

    local target =
        M.nearestMob(quest.mob)

    if target then

        M._target = target

        local part =
            target:FindFirstChild("HumanoidRootPart")
            or target.PrimaryPart

        local root = hrp()

        if not part or not root then
            task.wait(0.2)
            return
        end

        local distance =
            (part.Position - root.Position).Magnitude

        if distance > M.config.hoverRange then

            Teleport.go(
                part.Position
                + Vector3.new(
                    0,
                    M.config.heightOffset,
                    0
                )
            )

            task.wait(
                math.clamp(
                    distance / Teleport.config.speed,
                    0.2,
                    5
                )
            )
        end

        if M.config.equip then
            M.equipWeapon(
                M.config.equipType
            )
        end

        if M.config.bring then

            M._anchor =
                part.Position

            for _, enemy in ipairs(mobs) do
                Combat.attackOnce(enemy)
            end

        else

            Combat.attackOnce(target)
        end

        task.wait(
            M.config.attackInterval
        )

        return
    end

    -- No enemy found.
    -- Move toward its spawn.

    local spawn =
        M.spawns[quest.mob]

    local root = hrp()

    if spawn and root then

        local distance =
            (root.Position - spawn).Magnitude

        if distance > 150 then

            Teleport.go(
                spawn
                + Vector3.new(
                    0,
                    M.config.heightOffset,
                    0
                )
            )

            task.wait(
                math.clamp(
                    distance / Teleport.config.speed,
                    0.3,
                    5
                )
            )

        else

            task.wait(1)

        end

    else

        task.wait(1)
    end
end

--========================================================
-- LEVEL FARM
--========================================================

function M.runFarmLoop()

    local generation = M._farmGen

    task.spawn(function()

        while
            M._farmOn
            and M._farmGen == generation
        do

            M._lastTick = os.clock()

            local ok, err =
                pcall(function()
                    M._farmStep()
                end)

            if not ok then
                warn(
                    "[Farm Error]",
                    tostring(err)
                )

                task.wait(0.5)
            end
        end
    end)
end

function M.startWatchdog()

    if M._watchdogOn then
        return
    end

    M._watchdogOn = true

    task.spawn(function()

        while M._farmOn do

            if
                M._lastTick > 0
                and os.clock() - M._lastTick > 5
            then

                M._farmGen += 1
                M._lastTick = os.clock()

                M.runFarmLoop()
            end

            task.wait(2)
        end

        M._watchdogOn = false
    end)
end

function M.setFarm(state)

    M._farmOn = state

    if state then
        M._bossOn = false
        M._nearestOn = false
    end

    M._curKey = nil
    M._target = nil
    M._anchor = nil
    M._collecting = false

    M._killCount = 0
    M._killReq = 8
    M._prevAlive = nil

    M._fruitSkip =
        setmetatable({}, {__mode="k"})

    M._fruitTries =
        setmetatable({}, {__mode="k"})

    M._decollided =
        setmetatable({}, {__mode="k"})

    if state then

        M._farmGen += 1
        M._lastTick = os.clock()

        M.runFarmLoop()
        M.startWatchdog()
    end
end

--========================================================
-- NEAREST FARM
--========================================================

function M.setNearestFarm(state)

    M._nearestOn = state

    if state then
        M._farmOn = false
        M._bossOn = false
    end

    if not state then
        M._target = nil
        return
    end

    task.spawn(function()

        while M._nearestOn do

            local target =
                Combat.nearest()

            if target then

                M._target = target

                local part =
                    target:FindFirstChild("HumanoidRootPart")
                    or target.PrimaryPart

                local root = hrp()

                if part and root then

                    local distance =
                        (part.Position - root.Position).Magnitude

                    if distance > M.config.hoverRange then

                        Teleport.go(
                            part.Position
                            + Vector3.new(
                                0,
                                M.config.heightOffset,
                                0
                            )
                        )
                    end

                    if M.config.equip then
                        M.equipWeapon(
                            M.config.equipType
                        )
                    end

                    Combat.attackOnce(target)
                end

            else

                M._target = nil

            end

            task.wait(
                M.config.attackInterval
            )
        end
    end)
end

--========================================================
-- BOSS FARM
--========================================================

function M.setBossFarm(state)

    M._bossOn = state

    if state then
        M._farmOn = false
        M._nearestOn = false
    end

    M._target = nil

    if not state then
        return
    end

    task.spawn(function()

        while M._bossOn do

            local boss =
                M.selectedBoss

            if not boss then

                task.wait(1)

            else

                local target =
                    M.nearestMob(
                        boss.name
                    )

                if target then

                    M._target = target

                    local part =
                        target:FindFirstChild("HumanoidRootPart")
                        or target.PrimaryPart

                    local root = hrp()

                    if part and root then

                        local distance =
                            (part.Position - root.Position).Magnitude

                        if distance > M.config.hoverRange then

                            Teleport.go(
                                part.Position
                                + Vector3.new(
                                    0,
                                    M.config.heightOffset,
                                    0
                                )
                            )
                        end

                        if M.config.equip then
                            M.equipWeapon(
                                M.config.equipType
                            )
                        end

                        Combat.attackOnce(target)
                    end

                    task.wait(
                        M.config.attackInterval
                    )

                else

                    M._target = nil

                    if boss.pos then

                        Teleport.go(
                            boss.pos
                            + Vector3.new(
                                0,
                                M.config.heightOffset,
                                0
                            )
                        )
                    end

                    task.wait(2)
                end
            end
        end
    end)
end

