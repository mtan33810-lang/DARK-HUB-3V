local function pressKey(key)
    local keyCode = Enum.KeyCode[key]

    if not keyCode then
        return
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            true,
            keyCode,
            false,
            game
        )

        task.wait(0.03)

        VirtualInputManager:SendKeyEvent(
            false,
            keyCode,
            false,
            game
        )
    end)
end

local function startAutoSkills()
    if State.autoSkills then
        return
    end

    State.autoSkills = true

    spawnThread(function()
        while State.autoSkills do
            for _, key in ipairs({
                "Z",
                "X",
                "C",
                "V",
                "F",
            }) do
                if not State.autoSkills then
                    break
                end

                if Config.skills[key] then
                    pressKey(key)
                end
            end

            task.wait(Config.skillInterval)
        end
    end)
end

local function stopAutoSkills()
    State.autoSkills = false
end

--//========================================================
--// FOLLOW
--//========================================================

local function startFollow()
    if State.follow then
        return
    end

    State.follow = true

    spawnThread(function()
        while State.follow do
            local target =
                getNearestPlayer()

            local targetRoot =
                target and getRoot(target)

            local myRoot =
                getMyRoot()

            if targetRoot and myRoot then
                local destination =
                    targetRoot.Position
                    - targetRoot.CFrame.LookVector
                    * Config.followDistance

                pcall(function()
                    myRoot.CFrame =
                        CFrame.lookAt(
                            destination,
                            targetRoot.Position
                        )
                end)

                if Config.attackFollowTarget then
                    attackTarget(target)
                end
            end

            task.wait(0.25)
        end
    end)
end

local function stopFollow()
    State.follow = false
end

--//========================================================
--// AIMBOT
--//========================================================

connect(
    RunService.RenderStepped:Connect(function()
        if not Config.aimbot then
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local target =
            getNearestPlayer()

        local targetRoot =
            target and getRoot(target)

        if targetRoot then
            local desired =
                CFrame.lookAt(
                    camera.CFrame.Position,
                    targetRoot.Position
                )

            camera.CFrame =
                camera.CFrame:Lerp(
                    desired,
                    Config.aimSmooth
                )
        end
    end)
)

--//========================================================
--// SPECTATE
--//========================================================

connect(
    RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        if Config.spectate then
            local target =
                getNearestPlayer()

            local humanoid =
                target and getHumanoid(target)

            if humanoid then
                if not State.oldCameraSubject then
                    State.oldCameraSubject =
                        camera.CameraSubject
                end

                camera.CameraSubject = humanoid
            end
        else
            if State.oldCameraSubject then
                camera.CameraSubject =
                    State.oldCameraSubject

                State.oldCameraSubject = nil
            end
        end
    end)
)

--//========================================================
--// BOUNTY HELPERS
--//========================================================

local function healthPercent()
    local humanoid = getMyHumanoid()

    if not humanoid or humanoid.MaxHealth <= 0 then
        return 100
    end

    return
        (humanoid.Health / humanoid.MaxHealth) * 100
end

local function isHoldingCup(character)
    if not character then
        return false
    end

    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Tool")
            and object.Name == "Cup"
        then
            return true
        end
    end

    return false
end

local function validBountyTarget(player)
    if player == LocalPlayer then
        return false
    end

    local character = player.Character
    local humanoid = getHumanoid(character)
    local root = getRoot(character)

    if not humanoid
        or humanoid.Health <= 0
        or not root
    then
        return false
    end

    if Config.bounty.noFriends then
        local success, isFriend =
            pcall(function()
                return LocalPlayer:IsFriendsWith(
                    player.UserId
                )
            end)

        if success and isFriend then
            return false
        end
    end

    if Config.bounty.noCup
        and isHoldingCup(character)
    then
        return false
    end

    if Config.bounty.team ~= "Both" then
        if player.Team then
            if not string.find(
                string.lower(player.Team.Name),
                string.lower(Config.bounty.team)
            ) then
                return false
            end
        end
    end

    return true
end

local function selectBounty()
    local myRoot = getMyRoot()

    if not myRoot then
        return nil
    end

    local best
    local bestScore

    for _, player in ipairs(Players:GetPlayers()) do
        if validBountyTarget(player) then
            local character = player.Character
            local root = getRoot(character)
            local humanoid = getHumanoid(character)

            local score

            if Config.bounty.method == "Lowest HP" then
                score = humanoid.Health
            else
                score =
                    (root.Position - myRoot.Position).Magnitude
            end

            if not bestScore or score < bestScore then
                best = player
                bestScore = score
            end
        end
    end

    return best
end

--//========================================================
--// CHAT
--//========================================================

local function sendChat(message)
    pcall(function()
        local TextChatService =
            game:GetService("TextChatService")

        if TextChatService.ChatVersion ==
            Enum.ChatVersion.TextChatService
        then
            local channels =
                TextChatService:FindFirstChild("TextChannels")

            local general =
                channels
                and channels:FindFirstChild("RBXGeneral")

            if general then
                general:SendAsync(message)
            end
        else
            local events =
                ReplicatedStorage
                :FindFirstChild("DefaultChatSystemChatEvents")

            local request =
                events
                and events:FindFirstChild("SayMessageRequest")

            if request then
                request:FireServer(
                    message,
                    "All"
                )
            end
        end
    end)
end

--//========================================================
--// AUTO BOUNTY
--//========================================================

local function startBounty()
    if State.bounty then
        return
    end

    State.bounty = true

    spawnThread(function()
        while State.bounty do
            if healthPercent() <=
                Config.bounty.safeHealth
            then
                local character = getCharacter()
                local root = getRoot(character)

                if root then
                    pcall(function()
                        root.CFrame =
                            root.CFrame
                            + Vector3.new(0, 100, 0)
                    end)
                end

                task.wait(1)
            else
                local target =
                    selectBounty()

                if target then
                    local startTime =
                        os.clock()

                    while State.bounty
                        and os.clock() - startTime
                            < Config.bounty.maxTargetTime
                    do
                        if healthPercent() <=
                            Config.bounty.safeHealth
                        then
                            break
                        end

                        local character =
                            target.Character

                        local humanoid =
                            getHumanoid(character)

                        local targetRoot =
                            getRoot(character)

                        if not character
                            or not humanoid
                            or humanoid.Health <= 0
                            or not targetRoot
                        then
                            if Config.bounty.chatAfterKill then
                                sendChat(
                                    Config.bounty.chatMessage
                                )
                            end

                            break
                        end

                        local offset =
                            Config.followDistance

                        local yOffset =
                            Config.bounty.invisibleKen
                            and 4
                            or 0

                        local destination =
                            targetRoot.Position
                            - targetRoot.CFrame.LookVector
                            * offset
                            + Vector3.new(
                                0,
                                yOffset,
                                0
                            )

                        local myRoot =
                            getMyRoot()

                        if myRoot then
                            pcall(function()
                                myRoot.CFrame =
                                    CFrame.lookAt(
                                        destination,
                                        targetRoot.Position
                                    )
                            end)
                        end

                        attackTarget(character)

                        task.wait(attackDelay())
                    end
                else
                    task.wait(0.5)
                end
            end
        end
    end)
end

local function stopBounty()
    State.bounty = false
end

--//========================================================
--// NO STUN
--//========================================================

local function startNoStun()
    if State.noStun then
        return
    end

    State.noStun = true

    spawnThread(function()
        while State.noStun do
            local character =
                getCharacter()

            local humanoid =
                getHumanoid(character)

            if humanoid then
                if humanoid.PlatformStand then
                    humanoid.PlatformStand = false
                end
            end

            if character then
                for _, attribute in ipairs({
                    "Stun",
                    "Stunned",
                }) do
                    if character:GetAttribute(attribute) then
                        character:SetAttribute(
                            attribute,
                            false
                        )
                    end
                end
            end

            task.wait(0.1)
        end
    end)
end

local function stopNoStun()
    State.noStun = false
end

