                Duration = 2
            })

            return
        end

        --==========================================
        -- CHECK RARITY SELECTION
        --==========================================

        local CombinedList = GetSelectedEggsList()

        if #CombinedList == 0 then

            local HasAnySelected = false

            for _, v in pairs(SelectedRarities) do

                if v then
                    HasAnySelected = true
                    break
                end
            end

            if not HasAnySelected then

                AutoEggPickup = false
                AutoEggPickupToggle:Set(false)

                Rayfield:Notify({
                    Title = "Egg Scanner",
                    Content = "Select at least one rarity first.",
                    Duration = 3
                })

                return
            end
        end

        --==========================================
        -- SCAN
        --==========================================

        ScanEggs()

        CombinedList = GetSelectedEggsList()

        --==========================================
        -- REMOVE EQUIPPED EGGS FROM LIST
        --==========================================

        for i = #CombinedList, 1, -1 do

            local Data = CombinedList[i]

            if Data
                and Data.Object
                and IsEggEquipped(Data.Object) then

                table.remove(CombinedList, i)
            end
        end

        --==========================================
        -- NO EGGS
        --==========================================

        if #CombinedList == 0 then

            AutoEggPickup = false
            AutoEggPickupToggle:Set(false)

            Rayfield:Notify({
                Title = "Egg Pickup",
                Content = "No available eggs found.",
                Duration = 2
            })

            return
        end

