--==================================================
-- AUTO EGG PICKUP
--==================================================

local AutoEggPickup = false
local AutoEggWatcherRunning = false
local AutoEggPickupToggle

--==================================================
-- AUTO EGG PICKUP
--==================================================

AutoEggPickupToggle =
    TeleportsTab:CreateToggle({

        Name = "🥚 Teleport to Next Egg + Pick Up",

        CurrentValue = false,

        Flag = "AutoEggPickup",

        Callback = function(Value)

            AutoEggPickup = Value

            if not Value then

                Rayfield:Notify({
                    Title = "Egg Pickup",
                    Content = "Auto egg pickup stopped.",
                    Duration = 2,
                    Image = "play-off"
                })

                return
            end

            -- Always scan before checking eggs
            ScanEggs()

            local CombinedList =
                GetSelectedEggsList()

            if #CombinedList == 0 then

                local HasAnySelected = false

                for _, v in pairs(
                    SelectedRarities
                ) do

                    if v then
                        HasAnySelected = true
                        break
                    end
                end

                if not HasAnySelected then

                    AutoEggPickup = false
                    AutoEggPickupToggle:Set(false)

                    Rayfield:Notify({
                        Title = "Egg Scanner",
                        Content = "Select at least one rarity first.",
                        Duration = 3
                    })

                    return
                end

                AutoEggPickup = false
                AutoEggPickupToggle:Set(false)

                Rayfield:Notify({
                    Title = "Egg Pickup",
                    Content = "No available eggs found.",
                    Duration = 2
                })

                return
            end

            CurrentEggIndex = 0

            Rayfield:Notify({
                Title = "Egg Pickup",
                Content = "Started auto pickup!",
                Duration = 2
            })

            task.spawn(function()

                while AutoEggPickup do

                    ScanEggs()

                    local EggList =
                        GetSelectedEggsList()

                    if #EggList == 0 then

                        CurrentEggIndex = 0
                        AutoEggPickup = false

                        if AutoEggPickupToggle then
                            AutoEggPickupToggle:Set(false)
                        end

                        Rayfield:Notify({
                            Title = "Egg Pickup",
                            Content = "No available eggs found.",
                            Duration = 2
                        })

                        break
                    end

                    CurrentEggIndex =
                        (CurrentEggIndex or 0) + 1

                    if CurrentEggIndex >
                        #EggList
                    then
                        CurrentEggIndex = 1
                    end

                    local Data =
                        EggList[CurrentEggIndex]

                    if not Data
                        or not Data.Object
                        or not Data.Object.Parent
                    then
                        task.wait(0.3)
                        continue
                    end

                    local Egg =
                        Data.Object

                    if IsIgnoredDroppedEgg(Egg)
                        or IsEggEquipped(Egg)
                    then
                        task.wait(0.2)
                        continue
                    end

                    local CurrentCFrame =
                        GetObjectCFrame(Egg)

                    if CurrentCFrame then
                        Data.CFrame =
                            CurrentCFrame
                    end

                    if not Data.CFrame then
                        task.wait(0.3)
                        continue
                    end

                    local EggName =
                        tostring(
                            Data.EggName
                            or Egg.Name
                            or "Unknown Egg"
                        )

                    local EggNumber =
                        tostring(
                            Data.Number or "?"
                        )

                    local Rarity =
                        tostring(
                            Data.Rarity
                            or "Unknown"
                        )

                    Rayfield:Notify({
                        Title = "Egg Pickup",

                        Content =
                            EggName
                            .. " #"
                            .. EggNumber
                            .. "\n"
                            .. Rarity
                            .. " • "
                            .. CurrentEggIndex
                            .. "/"
                            .. #EggList,

                        Duration = 2,
                        Image = "egg"
                    })

                    --==================================================
                    -- TELEPORT DIRECTLY TO NEXT EGG
                    --==================================================

                    local LiveEggCFrame = GetObjectCFrame(Egg)

                    if not LiveEggCFrame then
                        task.wait(0.3)
                        continue
                    end

                    Data.CFrame = LiveEggCFrame

                    local Character = Player.Character

                    if not Character then
                        task.wait(0.3)
                        continue
                    end

                    local HRP = Character:FindFirstChild("HumanoidRootPart")

                    if not HRP then
                        task.wait(0.3)
                        continue
                    end

                    -- Instant teleport to the egg
                    HRP.CFrame = LiveEggCFrame + Vector3.new(0, 5, 0)

                        task.wait(0.2)
    
                    if not AutoEggPickup then
                        break
                    end

                    task.wait(0.4)

                    --==================================================
                    -- VERIFY
                    --==================================================

                    if not Egg
                        or not Egg.Parent
                        or IsIgnoredDroppedEgg(Egg)
                        or IsEggEquipped(Egg)
                    then
                        task.wait(0.2)
                        continue
                    end

                    --==================================================
                    -- FIND PICKUP PROMPT
                    --==================================================

                    local FoundPrompt = nil

                    for _, Object in ipairs(
                        Egg:GetDescendants()
                    ) do

                        if Object:IsA(
                            "ProximityPrompt"
                        ) then

                            local PromptText =
                                string.lower(
                                    tostring(
                                        Object.ActionText
                                        or ""
                                    )
                                )

                            if PromptText == "pick up"
                                or PromptText:find(
                                    "pick",
                                    1,
                                    true
                                )
                            then

                                FoundPrompt =
                                    Object

                                break
                            end
                        end
                    end

                    --==================================================
                    -- PICK UP
                    --==================================================

                    if FoundPrompt
                        and typeof(
                            fireproximityprompt
                        ) == "function"
                    then

                        if IsEggEquipped(Egg)
                            or IsIgnoredDroppedEgg(Egg)
                        then
                            task.wait(0.2)
                            continue
                        end

                        fireproximityprompt(
                            FoundPrompt
                        )

                        Rayfield:Notify({
                            Title = "Egg Pickup",

                            Content =
                                "Picked up "
                                .. EggName
                                .. " #"
                                .. EggNumber,

                            Duration = 2,
                            Image = "egg"
                        })

                        task.wait(0.8)

                        --==================================================
                        -- POST PICKUP FLOW
                        --==================================================

                        RunAfterEggPickup(Egg)

                        while PostPickupRunning
                            and AutoEggPickup
                        do
                            task.wait(0.1)
                        end

                        if not AutoEggPickup then
                            break
                        end

                        --==================================================
                        -- RESCAN AFTER DROP
                        --==================================================

                        ScanEggs()

                        task.wait(0.3)
                    else

                        task.wait(0.5)
                    end
                end
            end)
        end
    })

