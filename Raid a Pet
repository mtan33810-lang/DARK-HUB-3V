--==================================================
-- TWEEN TO NEXT EGG + PICK UP
-- AUTO OFF WHEN NO EGGS
-- AUTO ON WHEN EGGS RETURN
-- IGNORE CURRENTLY EQUIPPED EGG
--==================================================

local AutoEggPickup = false
local AutoEggWatcherRunning = false

local AutoEggPickupToggle

--==================================================
-- CHECK IF EGG IS CURRENTLY EQUIPPED
--==================================================

local function IsEggEquipped(EggObject)

    if not EggObject then
        return false
    end

    local Character = Player.Character

    if not Character then
        return false
    end

    -- Egg is directly inside the Character
    if EggObject:IsDescendantOf(Character) then
        return true
    end

    -- Check equipped Tools
    for _, Object in ipairs(Character:GetChildren()) do

        if Object:IsA("Tool") then

            -- Egg object is inside the equipped Tool
            if EggObject == Object
                or EggObject:IsDescendantOf(Object) then

                return true
            end

            -- Same-name safety check
            if EggObject.Name == Object.Name then
                return true
            end
        end
    end

    return false
end

