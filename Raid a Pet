--==================================================
-- FORMAT EGG NAME
--==================================================

local function FormatEggName(Name)

    Name = Name:gsub("_", " ")
    Name = Name:gsub("%s+", " ")
    Name = Name:gsub("^%s+", "")
    Name = Name:gsub("%s+$", "")

    return Name
end

--==================================================
-- GET OBJECT CFRAME
--==================================================

local function GetObjectCFrame(Object)

    if Object:IsA("BasePart") then
        return Object.CFrame

    elseif Object:IsA("Model") then
        return Object:GetPivot()
    end

    return nil
end

--==================================================
-- CHECK IF INSIDE PLOT
--==================================================

local function IsInsidePlot(Object)

    local Current = Object.Parent

    while Current and Current ~= workspace do

        local Name =
            string.lower(Current.Name)

        if string.find(Name, "plot", 1, true)
            or string.find(Name, "farm", 1, true)
            or string.find(Name, "garden", 1, true)
        then
            return true
        end

        Current = Current.Parent
    end

    return false
end

--==================================================
-- GET ACTUAL EGG CONTAINER
--==================================================

local function GetEggObject(Object)

    local Current = Object

    while Current and Current ~= workspace do

        local FormattedName =
            FormatEggName(Current.Name)

        if ValidEggNames[FormattedName] then
            return Current, FormattedName
        end

        Current = Current.Parent
    end

    return nil, nil
end

--==================================================
-- SCAN EGGS
--==================================================

local function ScanEggs()

    EggData = {}

    EggsByRarity = {}

    for _, Rarity in ipairs(RarityOrder) do
        EggsByRarity[Rarity] = {}
    end

    local SeenEggs = {}
    local EggCounts = {}

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        local EggObject, EggName =
            GetEggObject(Object)

        if EggObject
            and EggName
            and not IsInsidePlot(EggObject)
        then

            if not SeenEggs[EggObject] then

                SeenEggs[EggObject] = true

                local ObjectCFrame =
                    GetObjectCFrame(EggObject)

                local Rarity =
                    EggRarity[EggName]

                if ObjectCFrame
                    and Rarity
                    and EggsByRarity[Rarity]
                then

                    EggCounts[EggName] =
                        (EggCounts[EggName] or 0) + 1

                    local Number =
                        EggCounts[EggName]

                    local DisplayName =
                        EggName .. " #" .. Number

                    local Data = {
                        Object = EggObject,
                        CFrame = ObjectCFrame,
                        EggName = EggName,
                        Rarity = Rarity,
                        Number = Number
                    }

                    EggData[DisplayName] = Data

                    table.insert(
                        EggsByRarity[Rarity],
                        Data
                    )
                end
            end
        end
    end

    -- Sort eggs
    for _, EggList in pairs(EggsByRarity) do

        table.sort(
            EggList,
            function(A, B)

                if A.EggName == B.EggName then
                    return A.Number < B.Number
                end

                return A.EggName < B.EggName
            end
        )
    end

    -- Refresh dropdown options while keeping existing selections intact
    if RarityDropdown then

        local Options = {}
        local KeptSelections = {}

        for _, Rarity in ipairs(RarityOrder) do

            local Count = #EggsByRarity[Rarity]
            local FormattedOption = Rarity .. " (" .. Count .. ")"

            table.insert(Options, FormattedOption)

            -- Check if this rarity was previously checked by the player
            if SelectedRarities[Rarity] then
                table.insert(KeptSelections, FormattedOption)
            end
        end

        -- Refresh with the newly built selection list
        RarityDropdown:Refresh(Options)
        RarityDropdown:Set(KeptSelections)
    end
end

