-- POST EGG PICKUP FLOW
--==================================================
--
-- Volcano ON + Saved ON
--     Volcano
--       ↓
--     10 sec delay
--       ↓
--     Saved Position
--       ↓
--     Drop Egg
--       ↓
--     5 sec delay
--       ↓
--     END
--
-- Volcano ON + Saved OFF
--     Volcano
--       ↓
--     10 sec delay
--       ↓
--     My Plot
--       ↓
--     END
--
-- Volcano OFF + Saved ON
--     Saved Position
--       ↓
--     Drop Egg
--       ↓
--     5 sec delay
--       ↓
--     END
--
-- Volcano OFF + Saved OFF
--     My Plot
--       ↓
--     END
--
--==================================================

local VolcanoPostDelay = 10
local EggDropPostDelay = 5

local function RunAfterEggPickup()

    if PostPickupRunning then
        return
    end

    PostPickupRunning = true

    task.spawn(function()

        --==========================================
        -- VOLCANO ON + SAVED ON
        -- Volcano → Delay → Saved → Drop → Delay
        --==========================================

        if VolcanoDipTween
            and SavedPositionTween
        then

            Rayfield:Notify({
                Title = "🥚 Egg Flow",
                Content = "Volcano → Saved Position → Drop",
                Duration = 2
            })

            local VolcanoSuccess =
                TweenToVolcanoDip()

            if VolcanoSuccess
                and VolcanoDipTween
                and SavedPositionTween
            then

                -- Delay AFTER volcano
                task.wait(VolcanoPostDelay)

                if not PostPickupRunning then
                    return
                end

                -- Tween to saved position
                local SavedSuccess =
                    TweenToSavedPosition()

                if SavedSuccess
                    and SavedPositionTween
                then

                    --==================================
                    -- DROP EGG AT SAVED POSITION
                    --==================================

                    task.wait(0.5)

                    local DropSuccess =
                        DropEgg()

                    if DropSuccess then

                        --==================================
                        -- 5 SECOND DELAY AFTER DROP
                        --==================================

                        Rayfield:Notify({
                            Title = "🥚 Egg Flow",
                            Content = "Egg dropped. Waiting 5 seconds...",
                            Duration = 2
                        })

                        task.wait(EggDropPostDelay)
                    end
                end
            end

        --==========================================
        -- VOLCANO ON + SAVED OFF
        -- Volcano → Delay → My Plot
        --==========================================

        elseif VolcanoDipTween
            and not SavedPositionTween
        then

            Rayfield:Notify({
                Title = "🥚 Egg Flow",
                Content = "Volcano → My Plot",
                Duration = 2
            })

            local VolcanoSuccess =
                TweenToVolcanoDip()

            if VolcanoSuccess then

                -- Delay AFTER volcano
                task.wait(VolcanoPostDelay)

                TeleportToMyPlot()
            end

        --==========================================
        -- VOLCANO OFF + SAVED ON
        -- Saved → Drop → 5 sec Delay
        --==========================================

        elseif not VolcanoDipTween
            and SavedPositionTween
        then

            Rayfield:Notify({
                Title = "🥚 Egg Flow",
                Content = "Saved Position → Drop Egg",
                Duration = 2
            })

            local SavedSuccess =
                TweenToSavedPosition()

            if SavedSuccess
                and SavedPositionTween
            then

                -- Small delay after arriving
                task.wait(0.5)

                --==================================
                -- DROP EGG
                --==================================

                local DropSuccess =
                    DropEgg()

                if DropSuccess then

                    Rayfield:Notify({
                        Title = "🥚 Egg Flow",
                        Content = "Egg dropped. Waiting 5 seconds...",
                        Duration = 2
                    })

                    --==================================
                    -- 5 SECOND DELAY
                    --==================================

                    task.wait(EggDropPostDelay)
                end
            end

        --==========================================
        -- BOTH OFF
        -- My Plot → END
        --==========================================

        else

            Rayfield:Notify({
                Title = "🥚 Egg Flow",
                Content = "Both disabled → My Plot",
                Duration = 2
            })

            TeleportToMyPlot()
        end

        PostPickupRunning = false
    end)
end

