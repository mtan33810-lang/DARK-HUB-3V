--==================================================
-- FIND MY PLOT
--==================================================

local function FindMyPlot()

    local PlotsFolder =
        workspace:FindFirstChild("Plots")

    if not PlotsFolder then
        return nil
    end

    for _, Plot in ipairs(PlotsFolder:GetChildren()) do

        local Data =
            Plot:FindFirstChild("Data")

        local Owner =
            Data and Data:FindFirstChild("Owner")

        -- StringValue
        if Owner and Owner:IsA("StringValue") then

            if Owner.Value == Player.Name then
                return Plot
            end
        end

        -- ObjectValue
        if Owner and Owner:IsA("ObjectValue") then

            if Owner.Value == Player then
                return Plot
            end
        end

        -- Attribute fallback
        local NestsOwnerLoaded =
            Plot:GetAttribute("NestsOwnerLoaded")

        if NestsOwnerLoaded == Player.UserId then
            return Plot
        end
    end

    return nil
end

--==================================================
-- GET PLOT POSITION
--==================================================

local function GetPlotCFrame(Plot)

    if not Plot then
        return nil
    end

    local PreferredNames = {
        "SpawnLocation",
        "Spawn",
        "PlotSpawn",
        "Main",
        "Base"
    }

    for _, Name in ipairs(PreferredNames) do

        local Part =
            Plot:FindFirstChild(Name, true)

        if Part and Part:IsA("BasePart") then
            return Part.CFrame
        end
    end

    -- Model / BasePart pivot fallback
    local Success, Pivot =
        pcall(function()
            return Plot:GetPivot()
        end)

    if Success then
        return Pivot
    end

    return nil
end

--==================================================
-- TELEPORT TO MY PLOT → UNEQUIP EGG
--==================================================

local function TeleportToMyPlot()

    local Character =
        Player.Character
        or Player.CharacterAdded:Wait()

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    --==============================================
    -- FIND MY PLOT
    --==============================================

    local Plot =
        FindMyPlot()

    if not Plot then

        Rayfield:Notify({
            Title = "🏠 My Plot",
            Content = "Could not find your plot.",
            Duration = 3
        })

        return false
    end

    --==============================================
    -- GET PLOT POSITION
    --==============================================

    local PlotCFrame =
        GetPlotCFrame(Plot)

    if not PlotCFrame then

        Rayfield:Notify({
            Title = "🏠 My Plot",
            Content = "Could not find plot position.",
            Duration = 3
        })

        return false
    end

    --==============================================
    -- TELEPORT TO MY PLOT FIRST
    --==============================================

    Root.CFrame =
        PlotCFrame + Vector3.new(0, 5, 0)

    Rayfield:Notify({
        Title = "🏠 My Plot",
        Content = "Teleported to your plot.",
        Duration = 2
    })

    --==============================================
    -- THEN UNEQUIP EGG
    --==============================================

    task.wait(0.3)

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then

        local EquippedTool =
            Character:FindFirstChildOfClass("Tool")

        if EquippedTool then

            local ToolName =
                string.lower(EquippedTool.Name)

            -- Only unequip tools containing "egg"
            if string.find(ToolName, "egg", 1, true) then

                Humanoid:UnequipTools()

                Rayfield:Notify({
                    Title = "🥚 Egg",
                    Content = "Egg unequipped at your plot.",
                    Duration = 2
                })

            end
        end
    end

    return true
end

