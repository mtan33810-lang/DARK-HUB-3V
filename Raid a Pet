local function DropEgg()

    local Remotes =
        ReplicatedStorage:FindFirstChild("Remotes")

    if not Remotes then
        return false
    end

    local GameRemotes =
        Remotes:FindFirstChild("Game")

    if not GameRemotes then
        return false
    end

    local BasketDrop =
        GameRemotes:FindFirstChild("BasketDrop")

    if not BasketDrop then

        Rayfield:Notify({
            Title = "🥚 Egg Drop",
            Content = "BasketDrop remote not found.",
            Duration = 3,
            Image = "egg"
        })

        return false
    end

    local Success, ErrorMessage =
        pcall(function()
            BasketDrop:FireServer()
        end)

    if not Success then

        Rayfield:Notify({
            Title = "🥚 Egg Drop",
            Content = "Failed to drop egg.",
            Duration = 3,
            Image = "egg"
