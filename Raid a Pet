        return false
    end

    Rayfield:Notify({
        Title = "🥚 Egg Drop",
        Content = "Egg dropped successfully!",
        Duration = 2,
        Image = "egg"
    })

    return true
end

--==================================================
-- POST EGG PICKUP FLOW
--==================================================

local VolcanoPostDelay = 10
local EggDropPostDelay = 5

local function RunAfterEggPickup(Egg)

    if PostPickupRunning then
        return
    end

    PostPickupRunning = true

    task.spawn(function()

        local Success, ErrorMessage = pcall(function()

            --==================================================
            -- BLACKLISTED EGG
            -- SKIP VOLCANO COMPLETELY
            --==================================================

            if IsBlacklistedEgg(Egg) then

                Rayfield:Notify({
                    Title = "🚫 Blacklisted Egg",
                    Content = "Volcano skipped.",
                    Duration = 2
                })

                --==============================================
                -- BLACKLIST + SAVED POSITION
                -- Pick Up → Saved → Drop
                --==============================================

                if SavedPositionTween then

                    Rayfield:Notify({
                        Title = "🥚 Egg Flow",
                        Content = "🚫 Volcano skipped → 📍 Saved → 🥚 Drop",
                        Duration = 2
                    })

                    local SavedSuccess =
                        TweenToSavedPosition()

                    if not SavedSuccess then
                        return
                    end

                    task.wait(0.5)

                    local DropSuccess =
                        DropEgg()

                    if DropSuccess then

                        MarkEggAsDropped(Egg)

                        Rayfield:Notify({
                            Title = "🥚 Egg Flow",
                            Content = "Blacklisted egg dropped at saved position.",
                            Duration = 2
                        })

                        task.wait(EggDropPostDelay)

                    end

                --==============================================
                -- BLACKLIST + NO SAVED POSITION
                -- Pick Up → My Plot
                --==============================================

                else

                    Rayfield:Notify({
                        Title = "🥚 Egg Flow",
                        Content = "🚫 Volcano skipped → 🏠 My Plot",
                        Duration = 2
                    })

                    TeleportToMyPlot()

                end

                return
            end


            --==================================================
            -- NORMAL EGG
            --==================================================

            --==================================================
            -- VOLCANO ON + SAVED POSITION ON
            -- Volcano → Saved → Drop
            --==================================================

            if VolcanoDipTween and SavedPositionTween then

                Rayfield:Notify({
                    Title = "🥚 Egg Flow",
                    Content = "🌋 Volcano → 📍 Saved → 🥚 Drop",
                    Duration = 2
                })

                -- 1. Volcano
                local VolcanoSuccess =
                    TweenToVolcanoDip()

                if not VolcanoSuccess then
                    return
                end

                -- 2. Wait at volcano
                task.wait(VolcanoPostDelay)

                -- 3. Saved position
                local SavedSuccess =
                    TweenToSavedPosition()

                if not SavedSuccess then
                    return
                end

                task.wait(0.5)

                -- 4. Drop
                local DropSuccess =
                    DropEgg()

                if DropSuccess then

                    MarkEggAsDropped(Egg)

                    Rayfield:Notify({
                        Title = "🥚 Egg Flow",
                        Content = "Egg dropped at saved position.",
                        Duration = 2
                    })

                    task.wait(EggDropPostDelay)

                end


            --==================================================
            -- VOLCANO ON + SAVED POSITION OFF
            -- Volcano → My Plot
            --==================================================

            elseif VolcanoDipTween
                and not SavedPositionTween then

                Rayfield:Notify({
                    Title = "🥚 Egg Flow",
                    Content = "🌋 Volcano → 🏠 My Plot",
                    Duration = 2
                })

                -- 1. Volcano
                local VolcanoSuccess =
                    TweenToVolcanoDip()

                if not VolcanoSuccess then
                    return
                end

                -- 2. Wait at volcano
                task.wait(VolcanoPostDelay)

                -- 3. My plot
                TeleportToMyPlot()


            --==================================================
            -- VOLCANO OFF + SAVED POSITION ON
            -- Saved → Drop
            --==================================================

            elseif not VolcanoDipTween
                and SavedPositionTween then

                Rayfield:Notify({
                    Title = "🥚 Egg Flow",
                    Content = "📍 Saved → 🥚 Drop",
                    Duration = 2
                })

                -- 1. Saved
                local SavedSuccess =
                    TweenToSavedPosition()

                if not SavedSuccess then
                    return
                end

                task.wait(0.5)

                -- 2. Drop
                local DropSuccess =
                    DropEgg()

                if DropSuccess then

                    MarkEggAsDropped(Egg)

                    Rayfield:Notify({
                        Title = "🥚 Egg Flow",
                        Content = "Egg dropped at saved position.",
                        Duration = 2
                    })

                    task.wait(EggDropPostDelay)

                end


            --==================================================
            -- BOTH OFF
            -- My Plot
            --==================================================

            else

                Rayfield:Notify({
                    Title = "🥚 Egg Flow",
                    Content = "🏠 My Plot",
                    Duration = 2
                })

                TeleportToMyPlot()

            end

        end)


        --==================================================
        -- ERROR HANDLING
        --==================================================

        if not Success then

            warn(
                "[EGG FLOW ERROR]",
                ErrorMessage
            )

        end

        -- Unlock pickup loop
        PostPickupRunning = false

    end)
end

