        -- START
        --==========================================

        Rayfield:Notify({
            Title = "Egg Pickup",
            Content = "Started auto pickup!",
            Duration = 2
        })

        task.spawn(function()

            while AutoEggPickup do

                --==================================
                -- GET CURRENT EGG LIST
                --==================================

                local EggList = GetSelectedEggsList()

                --==================================
                -- REMOVE STALE / EQUIPPED EGGS
                --==================================

                for i = #EggList, 1, -1 do

                    local Data = EggList[i]

                    if not Data
                        or not Data.Object
                        or not Data.Object.Parent then

                        table.remove(EggList, i)

                    elseif IsEggEquipped(Data.Object) then

                        -- Ignore currently equipped egg
                        table.remove(EggList, i)
                    end
                end

                --==================================
                -- NO EGGS
                --==================================

                if #EggList == 0 then

                    CurrentEggIndex = 0
                    AutoEggPickup = false

                    if AutoEggPickupToggle then
                        AutoEggPickupToggle:Set(false)
                    end

                    Rayfield:Notify({
                        Title = "Egg Pickup",
                        Content =
                            "No available eggs found. Toggle turned OFF.",

                        Duration = 2
                    })

                    break
                end

                --==================================
                -- NEXT EGG
                --==================================

                CurrentEggIndex = (CurrentEggIndex or 0) + 1

                if CurrentEggIndex > #EggList then
                    CurrentEggIndex = 1
                end

                local Data = EggList[CurrentEggIndex]

                if not Data then

                    ScanEggs()
                    task.wait(0.3)

                    continue
                end

                local Egg = Data.Object

                --==================================
                -- VERIFY EGG
                --==================================

                if not Egg or not Egg.Parent then

                    table.remove(EggList, CurrentEggIndex)

                    CurrentEggIndex =
                        math.max(CurrentEggIndex - 1, 0)

                    task.wait(0.2)

                    continue
                end

                --==================================
                -- CHECK EQUIPPED AGAIN
                --==================================

                if IsEggEquipped(Egg) then

                    task.wait(0.2)
                    continue
                end

                --==================================
                -- UPDATE POSITION
                --==================================

                local CurrentCFrame = GetObjectCFrame(Egg)

                if CurrentCFrame then
                    Data.CFrame = CurrentCFrame
                end

                if not Data.CFrame then

                    task.wait(0.5)
                    continue
                end

                --==================================
                -- EGG INFO
                --==================================

                local EggName =
                    tostring(
                        Data.EggName
                        or Egg.Name
                        or "Unknown Egg"
                    )

                local EggNumber =
                    tostring(Data.Number or "?")

                local Rarity =
                    tostring(Data.Rarity or "Unknown")

                Rayfield:Notify({
                    Title = "Egg Pickup",

                    Content =
                        EggName
                        .. " #"
                        .. EggNumber
                        .. "\n"
                        .. Rarity
                        .. " • "
                        .. CurrentEggIndex
                        .. "/"
                        .. #EggList,

                    Duration = 2
                })

                --==================================
                -- TWEEN TO EGG
                --==================================

                TweenTeleport(
                    Data.CFrame + Vector3.new(0, 5, 0),
                    1.5
                )

                if not AutoEggPickup then
                    break
                end

                -- Give tween time to finish
                task.wait(0.4)

                --==================================
                -- VERIFY AGAIN
                --==================================

                if not Egg or not Egg.Parent then

                    ScanEggs()
                    task.wait(0.3)

                    continue
                end

                --==================================
                -- DO NOT PICK UP EQUIPPED EGG
                --==================================

                if IsEggEquipped(Egg) then

                    task.wait(0.3)
                    continue
                end

                --==================================
                -- FIND PICKUP PROMPT
                --==================================

                local FoundPrompt = nil

                for _, Object in ipairs(Egg:GetDescendants()) do

                    if Object:IsA("ProximityPrompt") then

                        local PromptText =
                            string.lower(
                                tostring(
                                    Object.ActionText or ""
                                )
                            )

                        if PromptText == "pick up"
                            or PromptText:find(
                                "pick",
                                1,
                                true
                            ) then

                            FoundPrompt = Object
                            break
                        end
                    end
                end

                --==================================
                -- PICK UP
                --==================================

                if FoundPrompt
                    and typeof(fireproximityprompt) == "function" then

                    -- Final safety check
                    if IsEggEquipped(Egg) then

                        task.wait(0.3)
                        continue
                    end

                    fireproximityprompt(FoundPrompt)

                    Rayfield:Notify({
                        Title = "Egg Pickup",

                        Content =
                            "Picked up "
                            .. EggName
                            .. " #"
                            .. EggNumber,

                        Duration = 2
                    })

                    -- Allow pickup to register
                    task.wait(0.8)

                    --==================================
                    -- POST PICKUP FLOW
                    --==================================

                    RunAfterEggPickup()

                    while PostPickupRunning
                        and AutoEggPickup do

                        task.wait(0.1)
                    end

                    if not AutoEggPickup then
                        break
                    end

                    --==================================
                    -- RESCAN
                    --==================================

                    ScanEggs()
                    task.wait(0.3)

                    local RemainingEggs =
                        GetSelectedEggsList()

                    --==================================
                    -- REMOVE EQUIPPED EGGS
                    --==================================

                    for i = #RemainingEggs, 1, -1 do

                        local RemainingData =
                            RemainingEggs[i]

                        if RemainingData
                            and RemainingData.Object
                            and IsEggEquipped(
                                RemainingData.Object
                            ) then

                            table.remove(
                                RemainingEggs,
                                i
                            )
                        end
                    end

                    --==================================
                    -- NO EGGS AFTER PICKUP
                    --==================================

                    if #RemainingEggs == 0 then

                        CurrentEggIndex = 0
                        AutoEggPickup = false

                        if AutoEggPickupToggle then
                            AutoEggPickupToggle:Set(false)
                        end

                        Rayfield:Notify({
                            Title = "Egg Pickup",

                            Content =
                                "No available eggs. Toggle turned OFF until an egg respawns.",

                            Duration = 2
                        })

                        break
                    end

                else

                    --==================================
                    -- NO PICKUP PROMPT
                    --==================================

                    task.wait(0.5)
                end
            end
        end)
    end
})

--==================================================
-- AUTO EGG WATCHER
-- Turns toggle ON when an available egg comes back
--==================================================

if not AutoEggWatcherRunning then

    AutoEggWatcherRunning = true

    task.spawn(function()

        while true do

            task.wait(2)

            local HasAnySelected = false

            for _, v in pairs(SelectedRarities) do

                if v then
                    HasAnySelected = true
                    break
                end
            end

            if HasAnySelected then

                --==================================
                -- REFRESH EGG LIST
                --==================================

                ScanEggs()

                local EggList =
                    GetSelectedEggsList()

                --==================================
                -- REMOVE EQUIPPED EGGS
                --==================================

                for i = #EggList, 1, -1 do

                    local Data = EggList[i]

                    if not Data
                        or not Data.Object
                        or not Data.Object.Parent then

                        table.remove(EggList, i)

                    elseif IsEggEquipped(Data.Object) then

                        table.remove(EggList, i)
                    end
                end

                --==================================
                -- AVAILABLE EGG EXISTS
                --==================================

                if #EggList > 0 then

                    if not AutoEggPickup then

                        AutoEggPickup = true

                        if AutoEggPickupToggle then
                            AutoEggPickupToggle:Set(true)
                        end

                        Rayfield:Notify({
                            Title = "Egg Pickup",

                            Content =
                                "Available egg detected! Auto pickup turned ON.",

                            Duration = 2
                        })
                    end
                end
            end
        end
    end)
end

