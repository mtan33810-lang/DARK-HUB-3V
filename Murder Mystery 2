local function isGunHeldByPlayer(gun)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and gun:IsDescendantOf(player.Character) then
            return true
        end

        local backpack = player:FindFirstChild("Backpack")
        if backpack and gun:IsDescendantOf(backpack) then
            return true
        end
    end

    return false
end

local function createGunHighlight(gun)
    if GunHighlights[gun] then
        return
    end

    if isGunHeldByPlayer(gun) then
        return
    end

    local attachPart

    if gun:IsA("BasePart") then
        attachPart = gun
    else
        attachPart = gun:FindFirstChildWhichIsA("BasePart", true)
    end

    if not attachPart then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "XHIVI_GunHighlight"
    highlight.FillColor = Colors[Settings.GunHighlightColor] or Colors.Gold
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.3
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = Settings.HighlightGuns
    highlight.Parent = gun

    GunHighlights[gun] = {
        Highlight = highlight,
        AttachPart = attachPart,
    }
end

local function scanForDroppedGuns()
    for gun, data in pairs(GunHighlights) do
        if not gun or not gun.Parent then
            if data.Highlight then
                pcall(function()
                    data.Highlight:Destroy()
                end)
            end

            GunHighlights[gun] = nil
        end
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name:lower() == "gundrop" then
            createGunHighlight(object)
        end
    end
end

