--============================================================
-- AIM PART
--============================================================

local function getTargetPart(character)
    if not character then
        return nil
    end

    local aimPart = Settings.AimPart

    if aimPart == "Head" then
        return character:FindFirstChild("Head")

    elseif aimPart == "Torso" then
        return character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")

    elseif aimPart == "Left Arm" then
        return character:FindFirstChild("Left Arm")
            or character:FindFirstChild("LeftHand")

    elseif aimPart == "Right Arm" then
        return character:FindFirstChild("Right Arm")
            or character:FindFirstChild("RightHand")

    elseif aimPart == "Left Leg" then
        return character:FindFirstChild("Left Leg")
            or character:FindFirstChild("LeftFoot")

    elseif aimPart == "Right Leg" then
        return character:FindFirstChild("Right Leg")
            or character:FindFirstChild("RightFoot")

    elseif aimPart == "Random" then
        local parts = {
            "Head",
            "HumanoidRootPart",
            "Left Arm",
            "Right Arm",
            "Left Leg",
            "Right Leg",
        }

        local randomName = parts[math.random(1, #parts)]

        if randomName == "Head" then
            return character:FindFirstChild("Head")
        elseif randomName == "HumanoidRootPart" then
            return character:FindFirstChild("HumanoidRootPart")
        elseif randomName == "Left Arm" then
            return character:FindFirstChild("Left Arm")
                or character:FindFirstChild("LeftHand")
        elseif randomName == "Right Arm" then
            return character:FindFirstChild("Right Arm")
                or character:FindFirstChild("RightHand")
        elseif randomName == "Left Leg" then
            return character:FindFirstChild("Left Leg")
                or character:FindFirstChild("LeftFoot")
        elseif randomName == "Right Leg" then
            return character:FindFirstChild("Right Leg")
                or character:FindFirstChild("RightFoot")
        end
    end

    return character:FindFirstChild("Head")
end

