--============================================================
-- ROLE DETECTION
--============================================================

local function checkPlayerInventory(player)
    if player == LocalPlayer then
        return "INNOCENT"
    end

    local character = player.Character

    if character then
        local equipped = character:FindFirstChildOfClass("Tool")

        if equipped then
            local name = equipped.Name:lower()

            if name:find("knife") then
                return "MURDERER"
            elseif name:find("gun") then
                return "SHERIFF"
            end
        end
    end

    local backpack = player:FindFirstChild("Backpack")

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()

                if name:find("knife") then
                    return "MURDERER"
                elseif name:find("gun") then
                    return "SHERIFF"
                end
            end
        end
    end

    return "INNOCENT"
end

local function detectRoles()
    local innocent = 0
    local sheriff = 0
    local murderer = 0
    local spectators = 0

    local sheriffName = "None"
    local murdererName = "None"

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if not humanoid or humanoid.Health <= 0 then
                spectators += 1
            else
                local role = checkPlayerInventory(player)

                if role == "MURDERER" then
                    murderer += 1
                    murdererName = player.Name
                elseif role == "SHERIFF" then
                    sheriff += 1
                    sheriffName = player.Name
                else
                    innocent += 1
                end
            end
        end
    end

    if murdererName ~= "None" and murdererName ~= LastMurderer then
        notify(
            "🔴 MURDERER DETECTED",
            murdererName .. " is the Murderer!",
            4
        )
        LastMurderer = murdererName
    end

    if sheriffName ~= "None" and sheriffName ~= LastSheriff then
        notify(
            "🔵 SHERIFF DETECTED",
            sheriffName .. " is the Sheriff!",
            4
        )
        LastSheriff = sheriffName
    end

    if murdererName == "None" then
        LastMurderer = "None"
    end

    if sheriffName == "None" then
        LastSheriff = "None"
    end

    PlayerInfo.Innocent = innocent
    PlayerInfo.Sheriff = sheriff
    PlayerInfo.Murderer = murderer
    PlayerInfo.Spectators = spectators
    PlayerInfo.SheriffName = sheriffName
    PlayerInfo.MurdererName = murdererName
    PlayerInfo.Total = math.max(#Players:GetPlayers() - 1, 0)

    InnocentLabel:Set("🟢 Innocent: " .. innocent)
    SheriffLabel:Set("🔵 Sheriff: " .. sheriff .. " (" .. sheriffName .. ")")
    MurdererLabel:Set("🔴 Murderer: " .. murderer .. " (" .. murdererName .. ")")
    SpectatorLabel:Set("👁️ Spectators: " .. spectators)
    TotalLabel:Set("👥 Total Players: " .. PlayerInfo.Total)
end

--============================================================
-- AIMBOT
--============================================================

local function getClosestPlayer()
    local mousePosition = Vector2.new(Mouse.X, Mouse.Y)
    local closestDistance = Settings.AimbotFOV
    local closestPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then
                local part = getTargetPart(character)

                if part then
                    local screenPosition, visible =
                        Camera:WorldToViewportPoint(part.Position)

                    if visible then
                        local distance =
                            (Vector2.new(screenPosition.X, screenPosition.Y) - mousePosition).Magnitude

                        if distance < closestDistance then
                            closestDistance = distance
                            closestPart = part
                        end
                    end
                end
            end
        end
    end

    return closestPart
end

local function getMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and checkPlayerInventory(player) == "MURDERER" then

            local part = getTargetPart(player.Character)

            if part then
                return player, part
            end
        end
    end

    return nil, nil
end

--============================================================
-- SHOOTING
--============================================================

local function shootAt(target)
    if not target then
        return
    end

    local character = LocalPlayer.Character
    if not character then
        return
    end

    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()

            if name:find("gun") or name == "gun" then
                local remote =
                    tool:FindFirstChild("Remote")
                    or tool:FindFirstChild("Shoot")
                    or tool:FindFirstChild("Fire")

                if remote and remote:IsA("RemoteEvent") then
                    pcall(function()
                        remote:FireServer(target.Position, target.Position)
                    end)
                end

                break
            end
        end
    end
end

local function checkTrigger()
    if not Settings.TriggerBot then
        return
    end

    local mousePosition = Vector2.new(Mouse.X, Mouse.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local part = getTargetPart(player.Character)

            if part then
                local screenPosition, visible =
                    Camera:WorldToViewportPoint(part.Position)

                if visible then
                    local distance =
                        (Vector2.new(screenPosition.X, screenPosition.Y) - mousePosition).Magnitude

                    if distance < 50 then
                        shootAt(part)
                        break
                    end
                end
            end
        end
    end
end

