local function savePosition()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if root then
        LastCFrame = root.CFrame
    end
end

local function returnToPosition()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if root and LastCFrame then
        root.CFrame = LastCFrame
        notify("Returned", "Teleported back to your original position.", 2)
    end
end

local function startReturnTimer(duration)
    ReturnToken += 1
    local token = ReturnToken

    task.delay(duration, function()
        if token == ReturnToken then
            returnToPosition()
        end
    end)
end

