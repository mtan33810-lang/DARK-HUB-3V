RunService.RenderStepped:Connect(function()
    if Circle then
        Circle.Position = Vector2.new(Mouse.X, Mouse.Y)
        Circle.Radius = Settings.AimbotFOV
        Circle.Visible = Settings.Aimbot or Settings.SilentAim
    end

    noclipLoop()
    speedBoostLoop()

    if Settings.Aimbot then
        local target = getClosestPlayer()

        if target then
            Camera.CFrame =
                CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    if Settings.AimAtMurderer then
        local _, target = getMurderer()

        if target then
            Camera.CFrame =
                CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    checkTrigger()

    if Settings.AutoShoot then
        local _, target = getMurderer()

        if target then
            shootAt(target)
        end
    end

    for _, data in pairs(GunHighlights) do
        if data.Highlight then
            data.Highlight.Enabled = Settings.HighlightGuns
            data.Highlight.FillColor =
                Colors[Settings.GunHighlightColor] or Colors.Gold
        end
    end

    updateESP()
end)

