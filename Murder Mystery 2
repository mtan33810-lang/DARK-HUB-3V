local Circle

pcall(function()
    Circle = Drawing.new("Circle")
    Circle.Visible = false
    Circle.Thickness = 2
    Circle.NumSides = 100
    Circle.Filled = false
    Circle.Color = Color3.new(1, 1, 1)
end)

local function drawBox(player, color)
    if not Settings.ESP or not Settings.ESPBoxes then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not head or not root then
        return
    end

    local headPosition, headVisible =
        Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))

    local rootPosition, rootVisible =
        Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2, 0))

    if not headVisible or not rootVisible then
        return
    end

    local height = math.abs(headPosition.Y - rootPosition.Y)
    local width = height * 0.6
    local center = Vector2.new(
        rootPosition.X,
        rootPosition.Y + height / 2
    )

    local points = {
        {
            Vector2.new(center.X - width / 2, center.Y - height / 2),
            Vector2.new(center.X + width / 2, center.Y - height / 2),
        },
        {
            Vector2.new(center.X - width / 2, center.Y + height / 2),
            Vector2.new(center.X + width / 2, center.Y + height / 2),
        },
        {
            Vector2.new(center.X - width / 2, center.Y - height / 2),
            Vector2.new(center.X - width / 2, center.Y + height / 2),
        },
        {
            Vector2.new(center.X + width / 2, center.Y - height / 2),
            Vector2.new(center.X + width / 2, center.Y + height / 2),
        },
    }

    for _, pair in ipairs(points) do
        local line = Drawing.new("Line")
        line.Visible = true
        line.Thickness = 2
        line.From = pair[1]
        line.To = pair[2]
        line.Color = color
        line.Transparency = 1

        task.delay(0.03, function()
            pcall(function()
                line:Remove()
            end)
        end)
    end
end

local function drawTracer(player, color)
    if not Settings.ESP or not Settings.ESPTracers then
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    local position, visible =
        Camera:WorldToViewportPoint(root.Position)

    if not visible then
        return
    end

    local line = Drawing.new("Line")
    line.Visible = true
    line.Thickness = 1
    line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    line.To = Vector2.new(position.X, position.Y)
    line.Color = color
    line.Transparency = 1

    task.delay(0.03, function()
        pcall(function()
            line:Remove()
        end)
    end)
end

--============================================================
-- ESP UPDATE
--============================================================

local function updateESP()
    local localCharacter = LocalPlayer.Character
    local localRoot =
        localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESPData) do
        if not data.Billboard then
            continue
        end

        if not Settings.ESP then
            data.Billboard.Enabled = false
            continue
        end

        local character = player.Character
        local humanoid =
            character and character:FindFirstChildOfClass("Humanoid")
        local head = character and character:FindFirstChild("Head")

        if not humanoid or not head or humanoid.Health <= 0 then
            data.Billboard.Enabled = false
            continue
        end

        data.Billboard.Enabled = true
        data.Billboard.Adornee = head

        local role = checkPlayerInventory(player)

        local roleColor =
            role == "MURDERER"
                and Color3.new(1, 0, 0)
                or role == "SHERIFF"
                    and Color3.new(0, 0, 1)
                    or Color3.new(0, 1, 0)

        data.Name.Visible = Settings.ESPNames
        data.Role.Visible = Settings.ESPNames
        data.Distance.Visible = Settings.ESPDistance
        data.HealthBar.Visible = Settings.ESPHealth

        if Settings.ESPNames then
            data.Name.Text = player.Name
            data.Name.TextColor3 = roleColor

            data.Role.Text = role
            data.Role.TextColor3 = roleColor
        end

        if Settings.ESPDistance and localRoot then
            local root = character:FindFirstChild("HumanoidRootPart")

            if root then
                local distance =
                    math.floor((root.Position - localRoot.Position).Magnitude)

                data.Distance.Text = distance .. " studs"
            end
        end

        if Settings.ESPHealth then
            local percent =
                math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)

            data.HealthBar.Size =
                UDim2.new(percent, 0, 0.06, 0)

            if percent > 0.5 then
                data.HealthBar.BackgroundColor3 = Color3.new(0, 1, 0)
            elseif percent > 0.25 then
                data.HealthBar.BackgroundColor3 = Color3.new(1, 1, 0)
            else
                data.HealthBar.BackgroundColor3 = Color3.new(1, 0, 0)
            end
        end

        drawBox(player, roleColor)
        drawTracer(player, roleColor)
    end
end

