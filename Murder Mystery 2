--============================================================

local function noclipLoop()
    if not Settings.NoClip then
        return
    end

    local character = LocalPlayer.Character

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
            end
        end
    end
end

local function speedBoostLoop()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if Settings.SpeedBoost then
        humanoid.WalkSpeed = Settings.SpeedAmount
    end
end

UserInputService.JumpRequest:Connect(function()
    if not Settings.InfJump then
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

--============================================================
-- AUTOMATION
--============================================================

local function autoCollectCoins()
    if not Settings.AutoCollect then
        return
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("BasePart")
            and object.Name:lower():find("coin") then

            if (object.Position - root.Position).Magnitude < 30 then
                pcall(function()
                    firetouchinterest(root, object, 0)
                    firetouchinterest(root, object, 1)
                end)
            end
        end
    end
end

local function antiAFK()
    if not Settings.AntiAFK then
        return
    end

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function autoPickupGuns()
    if not Settings.AutoPickupGuns then
        return
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    for gun, data in pairs(GunHighlights) do
        if gun and gun.Parent and data.AttachPart then
            if (data.AttachPart.Position - root.Position).Magnitude < 20 then
                pcall(function()
                    firetouchinterest(root, data.AttachPart, 0)
                    firetouchinterest(root, data.AttachPart, 1)
                end)
            end
        end
    end
end

local function autoEquipGun()
    if not Settings.AutoEquipGun then
        return
    end

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if not character or not backpack then
        return
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()

            if name:find("gun") or name == "gun" then
                tool.Parent = character
                break
            end
        end
    end
end

--============================================================
-- TELEPORT TO GUN
--============================================================

local function findClosestGun()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local closestGun
    local closestDistance = math.huge

    for gun, data in pairs(GunHighlights) do
        if gun and gun.Parent and data.AttachPart then
            local distance =
                (data.AttachPart.Position - root.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestGun = gun
            end
        end
    end

    return closestGun
end

teleportToGun = function()
    local gun = findClosestGun()

    if not gun then
        notify("No Gun", "No dropped gun found nearby.", 2)
        return
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local data = GunHighlights[gun]

    if not root or not data or not data.AttachPart then
        return
    end

    savePosition()

    root.CFrame =
        CFrame.new(data.AttachPart.Position + Vector3.new(0, 5, 0))

    notify("Teleported", "Teleported to " .. gun.Name, 2)

    if Settings.TeleportReturn then
        startReturnTimer(Settings.ReturnDelay)
        notify(
            "Auto Return",
            "Returning in " .. math.floor(Settings.ReturnDelay) .. " seconds.",
            2
        )
    end
end

Guns:CreateButton({
    name = "Teleport to Closest Gun",
    callback = teleportToGun,
})

